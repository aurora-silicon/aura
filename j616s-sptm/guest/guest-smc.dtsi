// SPDX-License-Identifier: GPL-2.0-only
	// generated from aurora-wip t6040-j616s.dts: SMC, its mailbox, fan cooling on the CPU die zone (#560, #639, #642)
	smc_mbox: mailbox@50c608000 {
		compatible = "apple,t6041-asc-mailbox", "apple,asc-mailbox-v4";
		reg = <0x05 0xc608000 0x00 0x4000>;
		interrupts = <0x00 0x3e4 0x04>, <0x00 0x3e5 0x04>, <0x00 0x3e6 0x04>, <0x00 0x3e7 0x04>;
		interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
		#mbox-cells = <0x00>;
	};
	smc: smc@50c600000 {
		compatible = "apple,t6041-smc", "apple,t8103-smc";
		reg = <0x05 0xc600000 0x00 0x4000>, <0x05 0xde70000 0x00 0x100000>;
		reg-names = "smc", "sram";
		mboxes = <&smc_mbox>;

		smc_gpio: gpio {
			compatible = "apple,smc-gpio";
			gpio-controller;
			#gpio-cells = <0x02>;
		};

		smc_hwmon: hwmon {
			compatible = "apple,smc-hwmon";
			#thermal-sensor-cells = <0x01>;
			#cooling-cells = <0x03>;

			temperature-TCMz {
				apple,key-id = "TCMz";
				label = "CPU Die Max";
			};

			temperature-Tex0 {
				apple,key-id = "Tex0";
				label = "E-cluster Tex0";
			};

			temperature-Tex1 {
				apple,key-id = "Tex1";
				label = "E-cluster Tex1";
			};

			temperature-Tex2 {
