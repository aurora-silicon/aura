	};
	thermal-zones {
		cpu-die-thermal {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x3e8>;
			thermal-sensors = <&smc_hwmon 0x00>;

			trips {

				cpu_die_fan1: trip-fan1 {
					temperature = <0x124f8>;
					hysteresis = <0x2710>;
					type = "active";
				};

				cpu_die_fan2: trip-fan2 {
					temperature = <0x13880>;
					hysteresis = <0x1388>;
					type = "active";
				};

				cpu_die_fan3: trip-fan3 {
					temperature = <0x14c08>;
					hysteresis = <0x1388>;
					type = "active";
				};

				cpu_die_fan4: trip-fan4 {
					temperature = <0x15f90>;
					hysteresis = <0x1388>;
					type = "active";
				};

				cpu_die_fan5: trip-fan5 {
					temperature = <0x17318>;
					hysteresis = <0x1388>;
					type = "active";
				};

				cpu_die_passive: cpu-die-passive {
					temperature = <0x1b968>;
					hysteresis = <0x1388>;
					type = "passive";
				};

				cpu-die-critical {
					temperature = <0x1ccf0>;
					hysteresis = <0x00>;
					type = "critical";
				};
			};

			// F36.3: no fan cooling maps and no manual fan control: the SMC runs the fans itself (as upstream, cc3766d3).
			// F36 froze three times right after "Fan N refused manual mode after unlock" (Ftst unlock under the monitor).
		};
	};
