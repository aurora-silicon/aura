+/* macho F33: a call that never comes back from the monitor or SPTM leaves its CPU at EL2 with IRQs masked, and every
+ * later APIF caller spins on the monitor's lock (guest.c g_apif_lock). Each CPU records the batch it rang; a pinned
+ * hrtimer on every online CPU reads the records of the others and names on the panel the first operation whose ret the
+ * monitor has not written yet (it writes ret after each op, apif.c gw64(opa + 56)). Any CPU still taking its timer
+ * reports. ret of an op that never ran stays APIF_RET_PENDING for the caller, it is not read without done.
+ */
+#define APIF_RET_PENDING 0xa9a9a9a9a9a9a9a9ULL
+#define APIF_WATCH_PERIOD_MS 250
+#define APIF_STUCK_MS 500
+struct apif_inflight {
+	struct apif_batch *batch;	/* NULL when idle */
+	const char *name;
+	u64 t0, seq;
+	u32 n;
+};
+static DEFINE_PER_CPU(struct apif_inflight, apif_inflight);
+static DEFINE_PER_CPU(struct hrtimer, apif_watch_timer);
+/* every timer run stamps its CPU: a core whose stamp stops is silent (IRQs masked at EL1, or held at EL2) */
+static DEFINE_PER_CPU(u64, apif_beat);
+static DEFINE_PER_CPU(u64, apif_silent_reported);
+#define APIF_SILENT_MS 1500
+/* monitor breadcrumb of another core (HVC 0x7504, monitor F33): x0 = stage | ec << 8, x1 sel, x2 a0, x3 cntpct at the
+ * stage, x4 exits, x5 cntpct now. An older monitor leaves x0 = 0x7504. */
+#define MACHO_HVC_WHERE 0x7504
+static void apif_ask_monitor(int cpu)
+{
+	register u64 x0 asm("x0") = MACHO_HVC_WHERE;
+	register u64 x1 asm("x1") = cpu_logical_map(cpu);
+	register u64 x2 asm("x2"), x3 asm("x3"), x4 asm("x4"), x5 asm("x5");
+
+	asm volatile("hvc #0" : "+r"(x0), "+r"(x1), "=r"(x2), "=r"(x3), "=r"(x4), "=r"(x5) : : "x6", "x7", "memory");
+	if (x0 == MACHO_HVC_WHERE) {
+		pr_emerg("CPU-SILENT cpu%d monitor has no breadcrumb call\n", cpu);
+		return;
+	}
+	/* stage 0 back in the guest, 1 waiting for the APIF lock, 2 in an APIF batch, 3 in SPTM for an op, 9 terminated */
+	pr_emerg("CPU-SILENT cpu%d EL2 stage %llu ec %#llx sel %llx a0 %llx since %llu us, exits %llu\n", cpu, x0 & 0xff,
+		 (x0 >> 8) & 0x3f, x1, x2, x5 > x3 ? (x5 - x3) * 1000000 / (read_sysreg(cntfrq_el0) ?: 1) : 0, x4);
+}
+/* F34: the T8110 DART error block of the DART a stuck table-3 op names (monitor HVC 0x7505, read-only map of +0x8000; XNU reads
+ * it directly in XNU's DART interrupt handler). A translation fault shows as a non-zero status word with the address. */
+#define MACHO_HVC_DARTERR 0x7505
+static void apif_ask_dart(u64 dart_id)
+{
+	for (u64 inst = 0; inst < 2; inst++) {
+		register u64 x0 asm("x0") = MACHO_HVC_DARTERR;
+		register u64 x1 asm("x1") = dart_id;
+		register u64 x2 asm("x2") = inst;
+		register u64 x3 asm("x3"), x4 asm("x4");
+
+		asm volatile("hvc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "=r"(x3), "=r"(x4) : : "x5", "x6", "x7", "memory");
+		if (x0 == MACHO_HVC_DARTERR) {
+			pr_emerg("DART-ERR dart %llu: monitor has no error-block call\n", dart_id);
