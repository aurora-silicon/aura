 #include <asm/barrier.h>
@@ -38,6 +41,31 @@ static int __init setup_idle(char *arg)
 }
 early_param("idle", setup_idle);
 
+/*
+ * Runtime switch for the Linux guest under the SPTM monitor: boot with idle=nop, change to WFI only after the desktop has reported, so a
+ * core that does not wake leaves the status lines on the panel.
+ */
+static int idle_mode_set(const char *val, const struct kernel_param *kp)
+{
+	int m = sysfs_streq(val, "wfi") ? ARM64_IDLE_WFI : sysfs_streq(val, "yield") ? ARM64_IDLE_YIELD :
+		sysfs_streq(val, "nop") ? ARM64_IDLE_NOP : -1;
+
+	if (m < 0)
+		return -EINVAL;
+	WRITE_ONCE(idle, m);
+	return 0;
+}
+
+static int idle_mode_get(char *buf, const struct kernel_param *kp)
+{
+	static const char * const n[] = { "wfi", "yield", "nop" };
+
+	return sysfs_emit(buf, "%s\n", n[READ_ONCE(idle)]);
+}
+
+static const struct kernel_param_ops idle_mode_ops = { .set = idle_mode_set, .get = idle_mode_get };
+module_param_cb(mode, &idle_mode_ops, NULL, 0644);
+
