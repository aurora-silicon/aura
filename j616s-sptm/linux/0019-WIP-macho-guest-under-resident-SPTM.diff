diff --git c/arch/arm64/kvm/sptm.c i/arch/arm64/kvm/sptm.c
new file mode 100644
index 000000000000..7346f0d4f366
--- /dev/null
+++ i/arch/arm64/kvm/sptm.c
@@ -0,0 +1,452 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * KVM under the macho monitor: this kernel is itself a guest at EL1 under the monitor, and the monitor and Apple's resident
+ * SPTM own EL2. Stage-2 tables are SPTM objects, so VMs get a root and VMID from the monitor; a vCPU run is an HVC with the
+ * whole register file in a page that doubles as SPTM's guest_state. kvm-arm.mode=sptm selects this; KVM then stays off until
+ * "1" is written to /sys/kernel/macho_kvm/enable.
+ */
+#include <linux/arm-smccc.h>
+#include <linux/irqchip/arm-gic-v3.h>
+#include <linux/kobject.h>
+#include <linux/kvm_host.h>
+#include <linux/sysfs.h>
+
+#include <asm/cacheflush.h>
+#include <asm/kvm_emulate.h>
+#include <asm/kvm_hyp.h>
+#include <asm/kvm_mmu.h>
+#include <asm/kvm_pgtable.h>
+#include <asm/kvm_pkvm.h>
+#include <asm/macho_hv.h>
+
+#include "sys_regs.h"
+#include "vgic/vgic.h"
+
+bool kvm_sptm_active __read_mostly;
+u64 kvm_sptm_ich_vtr __read_mostly;
+static DEFINE_PER_CPU(u32, sptm_need_tlbi);	/* one bit per monitor VM handle */
+
+static long mhv(unsigned long fn, unsigned long a1, unsigned long a2, unsigned long a3, unsigned long a4,
+		unsigned long a5, struct arm_smccc_res *res)
+{
+	struct arm_smccc_res r;
+
+	arm_smccc_1_1_hvc(fn, a1, a2, a3, a4, a5, &r);
+	if (res)
+		*res = r;
+	return (long)r.a0;
+}
+
+int kvm_sptm_probe(void)
+{
+	struct arm_smccc_res r;
+	u64 parange;
+
+	if (mhv(MHV_PROBE, 0, 0, 0, 0, 0, &r) != MHV_MAGIC) {
+		kvm_err("sptm: no macho monitor answered\n");
+		return -ENODEV;
+	}
+	/* guest vtimer emulation needs CNTHCTL_EL2.EL1TVT */
+	if (!cpuid_feature_extract_unsigned_field(r.a3, ID_AA64MMFR0_EL1_ECV_SHIFT)) {
+		kvm_err("sptm: no FEAT_ECV, mmfr0 %lx\n", r.a3);
+		return -ENODEV;
+	}
+	parange = cpuid_feature_extract_unsigned_field(r.a3, ID_AA64MMFR0_EL1_PARANGE_SHIFT);
+	kvm_sptm_ich_vtr = r.a1 & ~ICH_VTR_EL2_SEIS;   /* the cap needs EL2; every CPU under the monitor has the broken SEIS */
+	kvm_info("sptm: monitor ok, ICH_VTR %lx PARange %llu\n", r.a1, parange);
+	return 0;
+}
+
+void sptm___kvm_flush_cpu_context(struct kvm_s2_mmu *mmu)
+{
+	this_cpu_or(sptm_need_tlbi, BIT(kvm_s2_mmu_to_kvm(mmu)->arch.sptm_handle - 1));
+}
+
+/*
+ * A guest without a PMU, for guests that read one anyway: Windows reads PMCR_EL0 unconditionally, and its boot loader and kernel time
+ * with PMCCNTR_EL0. N = 0, the cycle counter is the system counter (24 MHz under SPTM), the rest reads as zero. Linux has no PMU here to back
+ * KVM's model: the monitor shadows its PMC registers. Needs HACR_EL2[56]; runtime switch for the first flash.
+ * PMCCNTR_EL0 holds the base while the counter runs, the count while it stands. A count that stands while it is enabled stops the boot
+ * loader at its "Press any key" (QEMU).
+ */
+static bool sptm_pmu_traps = true;
+module_param_named(sptm_pmu_traps, sptm_pmu_traps, bool, 0644);
+
+static bool sptm_pmc_on(struct kvm_vcpu *vcpu)
+{
+	return (__vcpu_sys_reg(vcpu, PMCR_EL0) & ARMV8_PMU_PMCR_E) && (__vcpu_sys_reg(vcpu, PMCNTENSET_EL0) & BIT(31));
+}
+
+bool kvm_sptm_pmu_access(struct kvm_vcpu *vcpu, struct sys_reg_params *p)
+{
+	u64 enc = sys_reg(p->Op0, p->Op1, p->CRn, p->CRm, p->Op2), v = 0, cur;
+
+	/* Op1 3 is the EL0 group. PMINTEN{SET,CLR}_EL1 are Op1 0: Windows writes PMINTENCLR before anything else */
+	if (p->Op0 != 3 || !((p->Op1 == 3 && ((p->CRn == 9 && p->CRm >= 12) || (p->CRn == 14 && p->CRm >= 8))) ||
+			     (p->Op1 == 0 && p->CRn == 9 && p->CRm == 14)))
+		return false;
+	if (!vcpu_mode_priv(vcpu)) {
+		u64 en = __vcpu_sys_reg(vcpu, PMUSERENR_EL0);
+		bool ok = en & ARMV8_PMU_USERENR_EN;
+
+		/* the Windows kernel sets only CR: EL0 reads the cycle counter with EN clear */
+		if (enc == SYS_PMCCNTR_EL0 && !p->is_write && (en & ARMV8_PMU_USERENR_CR))
+			ok = true;
+		if (enc == SYS_PMUSERENR_EL0)
+			ok = !p->is_write;
+		if (!ok || p->Op1 == 0) {
+			kvm_inject_undefined(vcpu);
+			return true;
+		}
+	}
+	cur = sptm_pmc_on(vcpu) ? kvm_phys_timer_read() - __vcpu_sys_reg(vcpu, PMCCNTR_EL0) : __vcpu_sys_reg(vcpu, PMCCNTR_EL0);
+	switch (enc) {
+	case SYS_PMCR_EL0:
+		if (p->is_write) {
+			if (p->regval & ARMV8_PMU_PMCR_C)
+				cur = 0;
+			__vcpu_assign_sys_reg(vcpu, PMCR_EL0, p->regval & (ARMV8_PMU_PMCR_E | ARMV8_PMU_PMCR_LC));
+		}
+		v = __vcpu_sys_reg(vcpu, PMCR_EL0);
+		break;
+	case SYS_PMCCNTR_EL0:
+		if (p->is_write)
+			cur = p->regval;
+		v = cur;
+		break;
+	case SYS_PMCNTENSET_EL0:
+		if (p->is_write)
+			__vcpu_rmw_sys_reg(vcpu, PMCNTENSET_EL0, |=, p->regval & BIT(31));
+		v = __vcpu_sys_reg(vcpu, PMCNTENSET_EL0) & BIT(31);
+		break;
+	case SYS_PMCNTENCLR_EL0:
+		if (p->is_write)
+			__vcpu_rmw_sys_reg(vcpu, PMCNTENSET_EL0, &=, ~(p->regval & BIT(31)));
+		v = __vcpu_sys_reg(vcpu, PMCNTENSET_EL0) & BIT(31);
+		break;
+	case SYS_PMUSERENR_EL0:
+		if (p->is_write)
+			__vcpu_assign_sys_reg(vcpu, PMUSERENR_EL0, p->regval & ARMV8_PMU_USERENR_MASK);
+		v = __vcpu_sys_reg(vcpu, PMUSERENR_EL0);
+		break;
+	case SYS_PMCCFILTR_EL0:
+		if (p->is_write)
+			__vcpu_assign_sys_reg(vcpu, PMCCFILTR_EL0, p->regval);
+		v = __vcpu_sys_reg(vcpu, PMCCFILTR_EL0);
+		break;
+	default:			/* PMCEID, PMOVS, PMINTEN, PMSELR, PMSWINC, PMXEV*, PMEV*: RAZ/WI */
+		break;
+	}
+	__vcpu_assign_sys_reg(vcpu, PMCCNTR_EL0, sptm_pmc_on(vcpu) ? kvm_phys_timer_read() - cur : cur);
+	if (!p->is_write)
+		p->regval = v;
+	kvm_incr_pc(vcpu);
+	return true;
+}
+
+/* the register file both ways; guest_state offsets from SPTM's entry tail */
+static inline void gs_w(void *gs, unsigned int off, u64 v)
+{
+	*(u64 *)(gs + off) = v;
+}
+
+static inline u64 gs_r(void *gs, unsigned int off)
+{
+	return *(u64 *)(gs + off);
+}
+
+#define EL1_REGS(X)							\
+	X(MHV_TTBR0, TTBR0_EL1) X(MHV_TTBR1, TTBR1_EL1) X(MHV_TCR, TCR_EL1) X(MHV_MAIR, MAIR_EL1)			\
+	X(MHV_SCTLR, SCTLR_EL1) X(MHV_AMAIR, AMAIR_EL1) X(MHV_CPACR, CPACR_EL1) X(MHV_VBAR, VBAR_EL1)		\
+	X(MHV_ELR, ELR_EL1) X(MHV_SPSR, SPSR_EL1) X(MHV_ESR, ESR_EL1) X(MHV_FAR, FAR_EL1)			\
+	X(MHV_AFSR0, AFSR0_EL1) X(MHV_AFSR1, AFSR1_EL1) X(MHV_CONTEXTIDR, CONTEXTIDR_EL1)			\
+	X(MHV_CNTKCTL, CNTKCTL_EL1) X(MHV_ACTLR, ACTLR_EL1)
+
+#define GS_REGS(X)							\
+	X(MHV_GS_SP_EL1, SP_EL1) X(MHV_GS_MDSCR, MDSCR_EL1) X(MHV_GS_TPIDR, TPIDR_EL1) X(MHV_GS_TPIDR0, TPIDR_EL0)	\
+	X(MHV_GS_TPIDRRO, TPIDRRO_EL0) X(MHV_GS_PAR, PAR_EL1) X(MHV_GS_CSSELR, CSSELR_EL1)
+
+static void vcpu_to_run(struct kvm_vcpu *vcpu, void *gs, struct mhv_run *r)
+{
+	struct vgic_v3_cpu_if *cpu_if = &vcpu->arch.vgic_cpu.vgic_v3;
+	struct kvm_cpu_context *ctxt = &vcpu->arch.ctxt;
+	struct user_pt_regs *regs = vcpu_gp_regs(vcpu);
+	int i;
+
+	gs_w(gs, MHV_GS_HCR, vcpu->arch.hcr_el2 & ~HCR_TGE);
+	if (cpus_have_final_cap(ARM64_HAS_HCX))
+		gs_w(gs, MHV_GS_HCRX, vcpu->arch.hcrx_el2);
+	gs_w(gs, MHV_GS_SP_EL0, regs->sp);
+	for (i = 0; i < 31; i++)
+		gs_w(gs, MHV_GS_X0 + i * 8, regs->regs[i]);
+	gs_w(gs, MHV_GS_PC, regs->pc);
+	gs_w(gs, MHV_GS_PSTATE, regs->pstate);
+#define X(o, s) gs_w(gs, o, __vcpu_sys_reg(vcpu, s));
+	GS_REGS(X)
+#undef X
+#define X(o, s) r->el1[o] = __vcpu_sys_reg(vcpu, s);
+	EL1_REGS(X)
+#undef X
+	memcpy(gs + MHV_GS_Q0, ctxt->fp_regs.vregs, sizeof(ctxt->fp_regs.vregs));
+	gs_w(gs, MHV_GS_FPSR, ctxt->fp_regs.fpsr);
+	gs_w(gs, MHV_GS_FPCR, ctxt->fp_regs.fpcr);
+	{
+		u32 me = BIT(vcpu->kvm->arch.sptm_handle - 1);
+
+		gs_w(gs, MHV_GS_TLBFLAG, !!(this_cpu_read(sptm_need_tlbi) & me));
+		this_cpu_and(sptm_need_tlbi, ~me);
+	}
+	gs_w(gs, MHV_GS_HACR, sptm_pmu_traps ? BIT(56) : 0);
+
+	r->handle = vcpu->kvm->arch.sptm_handle;
+	r->vmpidr = __vcpu_sys_reg(vcpu, MPIDR_EL1);
+	r->vpidr = kvm_read_vm_id_reg(vcpu->kvm, SYS_MIDR_EL1);
+	/*
+	 * Nothing switches the breakpoint and watchpoint registers: they stay Linux's, FGT keeps the guest in KVM's shadow. TDA would do that
+	 * too but also traps MDSCR_EL1, which Windows reads on every exception: 1.8 M exits to its Setup page (QEMU). SPTM loads
+	 * MDSCR from gs+0x48, so a read can go direct. XNU clears TDA on the first access  and switches the registers itself.
+	 */
+	r->mdcr = (vcpu->arch.mdcr_el2 & ~MDCR_EL2_TDA) | MDCR_EL2_TDOSA | MDCR_EL2_TDRA | MDCR_EL2_TDCC;	/* TDCC: the DCC registers TDA held */
+	if (kvm_host_owns_debug_regs(vcpu))
+		r->mdcr |= MDCR_EL2_TDA;
+	/* EL1PCTEN: the guest counter has no offset. No EL1PTEN and EL1TVT: both EL1 timers trap, KVM emulates them */
+	r->cnthctl_set = BIT(10) | BIT(13);
+	r->hfgrtr = *vcpu_fgt(vcpu, HFGRTR_EL2);
+	r->hfgwtr = *vcpu_fgt(vcpu, HFGWTR_EL2);
+	r->hfgitr = *vcpu_fgt(vcpu, HFGITR_EL2);
+	r->hdfgrtr = *vcpu_fgt(vcpu, HDFGRTR_EL2) | HDFGRTR_EL2_DBGBCRn_EL1 | HDFGRTR_EL2_DBGBVRn_EL1 | HDFGRTR_EL2_DBGWCRn_EL1 |
+		     HDFGRTR_EL2_DBGWVRn_EL1 | HDFGRTR_EL2_DBGCLAIM | HDFGRTR_EL2_DBGAUTHSTATUS_EL1 | HDFGRTR_EL2_DBGPRCR_EL1 |
+		     HDFGRTR_EL2_OSECCR_EL1;
+	r->hdfgwtr = *vcpu_fgt(vcpu, HDFGWTR_EL2) | HDFGWTR_EL2_DBGBCRn_EL1 | HDFGWTR_EL2_DBGBVRn_EL1 | HDFGWTR_EL2_DBGWCRn_EL1 |
+		     HDFGWTR_EL2_DBGWVRn_EL1 | HDFGWTR_EL2_DBGCLAIM | HDFGWTR_EL2_DBGPRCR_EL1 | HDFGWTR_EL2_MDSCR_EL1 |
+		     HDFGWTR_EL2_OSECCR_EL1;
+	r->pmc_on = sptm_pmc_on(vcpu);
+	r->pmc_val = __vcpu_sys_reg(vcpu, PMCCNTR_EL0);
+	r->pmuserenr = __vcpu_sys_reg(vcpu, PMUSERENR_EL0);
+	r->vsesr = vcpu->arch.vsesr_el2;
+	r->ich_hcr = cpu_if->vgic_hcr | vgic_ich_hcr_trap_bits();
+	r->ich_vmcr = cpu_if->vgic_vmcr;
+	r->used_lrs = cpu_if->used_lrs;
+	for (i = 0; i < 4; i++) {
+		r->ap0r[i] = cpu_if->vgic_ap0r[i];
+		r->ap1r[i] = cpu_if->vgic_ap1r[i];
+	}
+	for (i = 0; i < cpu_if->used_lrs; i++)
+		r->lr[i] = cpu_if->vgic_lr[i];
+}
+
+static void run_to_vcpu(struct kvm_vcpu *vcpu, void *gs, struct mhv_run *r)
+{
+	struct vgic_v3_cpu_if *cpu_if = &vcpu->arch.vgic_cpu.vgic_v3;
+	struct kvm_cpu_context *ctxt = &vcpu->arch.ctxt;
+	struct user_pt_regs *regs = vcpu_gp_regs(vcpu);
+	int i;
+
+	regs->sp = gs_r(gs, MHV_GS_SP_EL0);
+	for (i = 0; i < 31; i++)
+		regs->regs[i] = gs_r(gs, MHV_GS_X0 + i * 8);
+	regs->pc = gs_r(gs, MHV_GS_PC);
+	regs->pstate = gs_r(gs, MHV_GS_PSTATE);
+#define X(o, s) __vcpu_assign_sys_reg(vcpu, s, gs_r(gs, o));
+	GS_REGS(X)
+#undef X
+#define X(o, s) __vcpu_assign_sys_reg(vcpu, s, r->el1[o]);
+	EL1_REGS(X)
+#undef X
+	memcpy(ctxt->fp_regs.vregs, gs + MHV_GS_Q0, sizeof(ctxt->fp_regs.vregs));
+	ctxt->fp_regs.fpsr = gs_r(gs, MHV_GS_FPSR);
+	ctxt->fp_regs.fpcr = gs_r(gs, MHV_GS_FPCR);
+	vcpu->arch.fault.esr_el2 = r->esr;
+	vcpu->arch.fault.far_el2 = r->far;
+	vcpu->arch.fault.hpfar_el2 = r->hpfar;
+	vcpu->arch.fault.disr_el1 = 0;
+	if ((vcpu->arch.hcr_el2 & HCR_VSE) && !(r->hcr & HCR_VSE))
+		vcpu->arch.hcr_el2 &= ~HCR_VSE;    /* taken; hyp/include/hyp/switch.h does this on nVHE and VHE */
+	cpu_if->vgic_vmcr = r->ich_vmcr;
+	/* EOIcount is the one field of ICH_HCR the guest's run changes */
+	if (cpu_if->vgic_hcr & ICH_HCR_EL2_LRENPIE) {
+		cpu_if->vgic_hcr &= ~ICH_HCR_EL2_EOIcount;
+		cpu_if->vgic_hcr |= r->ich_hcr & ICH_HCR_EL2_EOIcount;
+	}
+	for (i = 0; i < 4; i++) {
+		cpu_if->vgic_ap0r[i] = r->ap0r[i];
+		cpu_if->vgic_ap1r[i] = r->ap1r[i];
+	}
+	for (i = 0; i < cpu_if->used_lrs; i++)
+		cpu_if->vgic_lr[i] = r->lr[i];
+}
+
+int sptm___kvm_vcpu_run(struct kvm_vcpu *vcpu)
+{
+	void *gs = vcpu->arch.sptm_run;
+	struct mhv_run *r = gs + MHV_RUN_OFF;
+	long code;
+
+	__kvm_adjust_pc(vcpu);
+	vcpu_to_run(vcpu, gs, r);
+	code = mhv(MHV_RUN, virt_to_phys(gs), 0, 0, 0, 0, NULL);
+	if (code == MHV_EXIT_BAD)
+		return ARM_EXCEPTION_IL;
+	run_to_vcpu(vcpu, gs, r);
+	if (code == MHV_EXIT_IRQ)
+		return ARM_EXCEPTION_IRQ;
+	if (code == MHV_EXIT_SERROR)
+		return ARM_EXCEPTION_EL1_SERROR;
+	return ARM_EXCEPTION_TRAP;
+}
+
+int kvm_sptm_vcpu_init(struct kvm_vcpu *vcpu)
+{
+	BUILD_BUG_ON(sizeof(struct mhv_run) > PAGE_SIZE - MHV_RUN_OFF);
+	vcpu->arch.sptm_run = (void *)get_zeroed_page(GFP_KERNEL_ACCOUNT);
+	return vcpu->arch.sptm_run ? 0 : -ENOMEM;
+}
+
+void kvm_sptm_vcpu_destroy(struct kvm_vcpu *vcpu)
+{
+	free_page((unsigned long)vcpu->arch.sptm_run);
+}
+
+/* stage 2: pgtable.c's interface, the tables live behind SPTM */
+static struct kvm *pgt_kvm(struct kvm_pgtable *pgt)
+{
+	return kvm_s2_mmu_to_kvm(pgt->mmu);
+}
+
+int skvm_pgtable_stage2_init(struct kvm_pgtable *pgt, struct kvm_s2_mmu *mmu, struct kvm_pgtable_mm_ops *mm_ops)
+{
+	long h = mhv(MHV_VM_CREATE, 0, 0, 0, 0, 0, NULL);
+
+	if (h <= 0) {
+		kvm_err("sptm: VM_CREATE: %ld\n", h);
+		return h ? (int)h : -ENOMEM;
+	}
+	pgt->mmu = mmu;
+	pgt->mm_ops = mm_ops;
+	kvm_s2_mmu_to_kvm(mmu)->arch.sptm_handle = h;
+	return 0;
+}
+
+void skvm_pgtable_stage2_destroy_range(struct kvm_pgtable *pgt, u64 addr, u64 size)
+{
+	WARN_ON(mhv(MHV_UNMAP, pgt_kvm(pgt)->arch.sptm_handle, addr, size, 0, 0, NULL));
+}
+
+void skvm_pgtable_stage2_destroy_pgd(struct kvm_pgtable *pgt)
+{
+	struct kvm *kvm = pgt_kvm(pgt);
+
+	WARN_ON(mhv(MHV_VM_DESTROY, kvm->arch.sptm_handle, 0, 0, 0, 0, NULL));
+	kvm->arch.sptm_handle = 0;
+}
+
+static u64 s2_attr(enum kvm_pgtable_prot prot)
+{
+	u64 a = BIT(10) | (3UL << 8);                       /* AF, inner shareable */
+
+	if (prot & KVM_PGTABLE_PROT_DEVICE)
+		a |= 1UL << 2;                              /* FWB Device-nGnRE */
+	else if (prot & KVM_PGTABLE_PROT_NORMAL_NC)
+		a |= 5UL << 2;                              /* FWB Normal-NC */
+	else
+		a |= 6UL << 2;                              /* FWB Normal WB: sptm_guest_enter forces HCR bit 46 */
+	if (prot & KVM_PGTABLE_PROT_R)
+		a |= BIT(6);
+	if (prot & KVM_PGTABLE_PROT_W)
+		a |= BIT(7);
+	if (!(prot & KVM_PGTABLE_PROT_X))
+		a |= 2UL << 53;
+	return a;
+}
+
+int skvm_pgtable_stage2_map(struct kvm_pgtable *pgt, u64 addr, u64 size, u64 phys, enum kvm_pgtable_prot prot, void *mc,
+			    enum kvm_pgtable_walk_flags flags)
+{
+	long r;
+
+	if (prot & KVM_PGTABLE_PROT_X)
+		__invalidate_icache_guest_page(phys_to_virt(phys), size);
+	r = mhv(MHV_MAP, pgt_kvm(pgt)->arch.sptm_handle, addr, phys, size, s2_attr(prot), NULL);
+	return r < 0 ? (int)r : 0;
+}
+
+int skvm_pgtable_stage2_unmap(struct kvm_pgtable *pgt, u64 addr, u64 size)
+{
+	return (int)mhv(MHV_UNMAP, pgt_kvm(pgt)->arch.sptm_handle, addr, size, 0, 0, NULL);
+}
+
+int skvm_pgtable_stage2_relax_perms(struct kvm_pgtable *pgt, u64 addr, enum kvm_pgtable_prot prot,
+				    enum kvm_pgtable_walk_flags flags)
+{
+	return (int)mhv(MHV_RELAX, pgt_kvm(pgt)->arch.sptm_handle, addr, s2_attr(prot), 0, 0, NULL);
+}
