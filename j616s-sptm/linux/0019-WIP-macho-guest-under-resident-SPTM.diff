@@ -752,17 +758,31 @@ int arch_prctl_mem_model_set(struct task_struct *t, unsigned long val)
 	if (alternative_has_cap_unlikely(ARM64_HAS_TSO_APPLE)) {
 		WARN_ON(!system_has_actlr_state());
 
+		/* a preemption before the msr makes actlr_thread_switch save the old register over the new thread.actlr */
+		preempt_disable();
 		switch (val) {
