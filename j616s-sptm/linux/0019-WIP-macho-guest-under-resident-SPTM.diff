+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! UAT backend for a guest under the resident SPTM, over APIF.
+//!
+//! Same shape as `apple-dart-apif.c`: the guest builds native SPTM calls, the monitor forwards
+//! them unchanged. Linux cannot reach the real tables: table frames are XNU_IOMMU (type 24), and
+//! the TTBAT, the shared L2 and the handoff page are protected I/O ranges (type 27).
+//!
+//! Selectors are table 7 of the SPTM:
+//!  0 INIT_STATE(state, root0, root1)      1 DESTROY_STATE(state)
+//!  2 MAP_TABLE(state, va, level, table)   3 UNMAP_TABLE(state, va, level)
+//!  4 MAP_BEGIN(state, va, segs, n, opts)  5 MAP_CONTINUE(state)
+//!  6 PREPARE_FW_UNMAP_BEGIN               7 PREPARE_FW_UNMAP_CONTINUE (inactive here)
+//!  8 UNMAP_BEGIN(state, segs, n)          9 UNMAP_CONTINUE(state)
+//! 10 SET_CTX_ID(state, ctx)              11 REMOVE_CTX_ID(state)
+//! 12 GET_INFO(selector)
+//!
+//! Rules of the firmware; a breach is a terminal SPTM violation, not an error return:
+//!  - one call at a time per state object (its guard byte), hence [`State::inner`];
+//!  - a table can be linked once (`prev_refcnt` must be 0), so tables are never shared;
+//!  - a root belongs to one state, and a state to one context;
+//!  - mapping over a valid leaf, or unmapping a free one, is fatal, so `pgtable.rs` passes only
+//!    ranges its shadow tree says are free or present.
+//!
+//! Nothing here has run on hardware.
+
+use super::*;
+use kernel::bindings;
+use core::pin::Pin;
+use kernel::error::to_result;
+use pin_init::{pin_data, pinned_drop};
+use kernel::page::Page;
+
+const TABLE_UAT: u64 = 7;
+const IOMMU_ID_UAT: u64 = 3;
+
+const fn sel(table: u64, endpoint: u64) -> u64 {
+    (table << 32) | endpoint
+}
+
+const SEL_RETYPE: u64 = sel(0, 1);
+const SERVICE: u64 = 0xffff_ffff;
+const SVC_TRANSLATE: u64 = sel(SERVICE, 1);
+const SVC_ALLOC_FRAME: u64 = sel(SERVICE, 2);
+const SVC_FREE_FRAME: u64 = sel(SERVICE, 3);
+
+const EP_INIT_STATE: u64 = 0;
+const EP_DESTROY_STATE: u64 = 1;
+const EP_MAP_TABLE: u64 = 2;
+const EP_UNMAP_TABLE: u64 = 3;
+const EP_MAP_BEGIN: u64 = 4;
+const EP_MAP_CONTINUE: u64 = 5;
+const EP_UNMAP_BEGIN: u64 = 8;
+const EP_UNMAP_CONTINUE: u64 = 9;
+const EP_SET_CTX_ID: u64 = 10;
+const EP_REMOVE_CTX_ID: u64 = 11;
+const EP_GET_INFO: u64 = 12;
+
+const INFO_MODE: u64 = 0;
+const INFO_GLOBAL_STATE_PRIVATE: u64 = 2;
+const INFO_VA_TOP_BIT: u64 = 3;
+const INFO_SEGMENT_LIMIT: u64 = 5;
+const INFO_STATE_SIZE: u64 = 8;
+
+/// `agx-address-space-mgmt-mode` 1, as in the J616s ADT: dual-root states, global state type 8.
+const MODE_PRIVATE: u64 = 1;
+
+const FRAME_XNU_DEFAULT: u64 = 11;
+const FRAME_XNU_IOMMU: u64 = 24;
+
+/// Subtypes `uat_retype_in` accepts, passed in the upper half of the RETYPE parameter.
+const SUBTYPE_STATE: u64 = 0;
+const SUBTYPE_ROOT: u64 = 1;
+const SUBTYPE_L2: u64 = 4;
+const SUBTYPE_L3: u64 = 5;
+
+/// `MAP_CONTINUE` and `UNMAP_CONTINUE` return this while the operation has more pages.
+const STATUS_MORE: u64 = 1;
+
+const L1_SHIFT: u32 = 36;
+const L2_SHIFT: u32 = 25;
+const PAGE_SHIFT_UAT: u32 = 14;
+
+/// Option bits of `MAP_BEGIN`, as macOS's GPU driver sets them.
+pub(crate) const OPT_FW_R: u32 = 1 << 0;
+pub(crate) const OPT_FW_W: u32 = 1 << 1;
+pub(crate) const OPT_ATTR_DEV: u32 = 1 << 2;
+pub(crate) const OPT_ATTR_UNCACHED: u32 = 1 << 3;
+pub(crate) const OPT_HW_R: u32 = 1 << 8;
+pub(crate) const OPT_HW_W: u32 = 1 << 9;
+
+fn submit(raw: *mut bindings::aurora_apif, selector: u64, arg: [u64; 6]) -> Result<u64> {
+    let mut op = bindings::aurora_apif_op {
+        selector,
+        arg,
+        ret: 0,
+    };
+    // SAFETY: `raw` comes from `aurora_apif_get` and stays valid while `Client` lives; `op` is a
+    // single valid operation that outlives this synchronous call.
+    let ret = unsafe { bindings::aurora_apif_submit(raw, &mut op, 1, core::ptr::null_mut()) };
+    to_result(ret)?;
+    Ok(op.ret)
+}
+
+/// The per-device APIF client and the facts read from the SPTM once.
+pub(crate) struct Client {
+    raw: core::ptr::NonNull<bindings::aurora_apif>,
+    /// `/arm-io/sgx` VA top bit, as SPTM computed it from `uat-vaddr-size`.
+    va_top_bit: u32,
+    segment_limit: usize,
+    global_state: u64,
+}
+
+// SAFETY: `aurora_apif_submit` is documented as safe from any context; the pointer is immutable.
+unsafe impl Send for Client {}
+// SAFETY: See above.
+unsafe impl Sync for Client {}
+
+impl Drop for Client {
+    fn drop(&mut self) {
+        // SAFETY: We own one reference taken in `Client::new`.
+        unsafe { bindings::aurora_apif_put(self.raw.as_ptr()) };
+    }
+}
+
+impl Client {
+    /// Connects to the monitor named by the GPU node's `aurora,apif`, if any.
+    ///
+    /// Returns `None` without such a property: the raw boot path.
+    pub(crate) fn probe(dev: &device::Device, ias: u32) -> Result<Option<Arc<Self>>> {
+        let node = dev.of_node().ok_or(EINVAL)?;
+        if !node.parse_phandle(c_str!("aurora,apif"), 0).is_some() {
+            return Ok(None);
+        }
+
+        dev_info!(dev, "UAT: SPTM backend: connecting to the monitor\n");
+        // SAFETY: `dev` is a valid bound device for the duration of this call.
+        let raw = unsafe { bindings::aurora_apif_get(dev.as_raw()) };
+        let raw = kernel::error::from_err_ptr(raw)?;
+        let raw_nn = core::ptr::NonNull::new(raw).ok_or(ENODEV)?;
+
+        let info = |what: u64| submit(raw, sel(TABLE_UAT, EP_GET_INFO), [what, 0, 0, 0, 0, 0]);
+        let mut this = Self {
+            raw: raw_nn,
+            va_top_bit: 0,
+            segment_limit: 0,
+            global_state: 0,
+        };
+
+        let mode = info(INFO_MODE)?;
+        let top = info(INFO_VA_TOP_BIT)?;
+        let limit = info(INFO_SEGMENT_LIMIT)?;
+        let state_size = info(INFO_STATE_SIZE)?;
+        dev_info!(
+            dev,
+            "UAT: SPTM backend: mode {} va top bit {} segments {} state size {:#x}\n",
+            mode,
+            top,
+            limit,
+            state_size
+        );
+        if mode != MODE_PRIVATE || top != ias as u64 || limit == 0 {
+            dev_err!(dev, "UAT: SPTM backend: unexpected geometry, ias {}\n", ias);
+            return Err(ENODEV);
+        }
+        // GET_INFO 2 panics in any other mode, so only ask after the check above.
+        this.global_state = info(INFO_GLOBAL_STATE_PRIVATE)?;
+        this.va_top_bit = top as u32;
+        this.segment_limit = limit as usize;
+        dev_info!(
+            dev,
+            "UAT: SPTM backend: global state {:#x}\n",
+            this.global_state
+        );
+        Ok(Some(Arc::new(this, GFP_KERNEL)?))
+    }
+
+    fn call(&self, selector: u64, arg: [u64; 6]) -> Result<u64> {
+        submit(self.raw.as_ptr(), selector, arg)
+    }
+
+    fn uat(&self, endpoint: u64, arg: [u64; 6]) -> Result<u64> {
+        self.call(sel(TABLE_UAT, endpoint), arg)
+    }
+
+    /// Takes a monitor frame outside the guest's stage-2 map and makes it a UAT frame.
+    fn alloc_frame(&self, subtype: u64) -> Result<u64> {
+        let pa = self.call(SVC_ALLOC_FRAME, [0; 6])?;
+        if pa == 0 || pa == u64::MAX {
+            return Err(ENOMEM);
+        }
+        // RETYPE returns a pointer, not a status (as XNU builds this parameter).
+        let ret = self.call(
+            SEL_RETYPE,
+            [
+                pa,
+                FRAME_XNU_DEFAULT,
+                FRAME_XNU_IOMMU,
+                IOMMU_ID_UAT | (subtype << 32),
+                0,
+                0,
+            ],
+        )?;
+        if ret == 0 {
+            self.call(SVC_FREE_FRAME, [pa, 0, 0, 0, 0, 0])?;
+            return Err(EIO);
+        }
+        Ok(pa)
+    }
+
+    /// Returns a frame retyped by [`Self::alloc_frame`], once SPTM holds no reference to it.
+    /// The provider retypes it back: a second retype here is a terminal violation (0x42).
+    fn free_frame(&self, pa: u64) -> Result {
+        self.call(SVC_FREE_FRAME, [pa, 0, 0, 0, 0, 0])?;
+        Ok(())
+    }
+
+    fn translate(&self, phys: u64, size: u64) -> Result<u64> {
+        self.call(SVC_TRANSLATE, [phys, size, 0, 0, 0, 0])
+    }
+}
+
+/// One entry of the segment list `MAP_BEGIN` copies: a physical run.
+#[repr(C)]
+#[derive(Copy, Clone)]
+struct MapSegment {
+    pa: u64,
+    pages: u64,
+}
+
+/// One entry of the segment list `UNMAP_BEGIN` copies: a virtual run.
+#[repr(C)]
+#[derive(Copy, Clone)]
+struct UnmapSegment {
+    va: u64,
+    pages: u64,
+}
+
+#[derive(Copy, Clone)]
+struct TableKey {
+    /// VA shifted right by the span of the table's parent entry; sign bits kept.
+    index: u64,
+    level: u8,
+    pa: u64,
+}
+
+struct StateInner {
+    /// Tables this state linked, sorted by (level, index).
+    tables: KVec<TableKey>,
+    ctx: Option<u16>,
+    /// A guest page of type XNU_DEFAULT that carries segment lists to SPTM.
+    segments: kernel::types::Owned<Page>,
+    segments_ipa: u64,
+    /// A call failed in transport, so the table state is unknown: retain everything.
+    failed: bool,
+}
+
+/// One SPTM UAT state object: a `Vm`'s address space as SPTM sees it.
+#[pin_data(PinnedDrop)]
+pub(crate) struct State {
+    client: Arc<Client>,
+    pa: u64,
+    /// The boot-created global state: never destroyed, its L1 is not ours to link.
+    global: bool,
+    roots: [u64; 2],
+    /// Serializes every call on this state object: a second concurrent call is a violation.
+    #[pin]
+    inner: Mutex<StateInner>,
+}
+
+impl State {
+    fn alloc(client: &Arc<Client>, pa: u64, global: bool, roots: [u64; 2]) -> Result<Arc<Self>> {
+        let segments = Page::alloc_page(GFP_KERNEL | __GFP_ZERO)?;
+        let segments_ipa = client.translate(segments.phys(), UAT_PGSZ as u64)?;
+        Arc::pin_init(
+            pin_init!(Self {
+                client: client.clone(),
+                pa,
+                global,
+                roots,
+                inner <- new_mutex!(
+                    StateInner {
+                        tables: KVec::new(),
+                        ctx: None,
+                        segments,
+                        segments_ipa,
+                        failed: false,
+                    },
+                    "uat_sptm_state"
+                ),
+            }),
+            GFP_KERNEL,
+        )
+    }
+
+    /// Creates a dual-root state for a `Vm` (lower half and an empty upper half).
+    pub(crate) fn new(client: &Arc<Client>) -> Result<Arc<Self>> {
+        let pa = client.alloc_frame(SUBTYPE_STATE)?;
+        let root0 = client.alloc_frame(SUBTYPE_ROOT).inspect_err(|_| {
+            let _ = client.free_frame(pa);
+        })?;
+        let root1 = client.alloc_frame(SUBTYPE_ROOT).inspect_err(|_| {
+            let _ = client.free_frame(root0);
+            let _ = client.free_frame(pa);
+        })?;
+        // An error here is a transport failure, the frames' state is unknown: they stay.
+        client.uat(EP_INIT_STATE, [pa, root0, root1, 0, 0, 0])?;
+        Self::alloc(client, pa, false, [root0, root1]).inspect_err(|_| {
+            if client.uat(EP_DESTROY_STATE, [pa, 0, 0, 0, 0, 0]).is_ok() {
+                let _ = client.free_frame(root0);
+                let _ = client.free_frame(root1);
+                let _ = client.free_frame(pa);
+            }
+        })
+    }
+
+    /// Wraps the boot-created global state: the driver's kernel window lives in its shared L2.
+    pub(crate) fn global(client: &Arc<Client>) -> Result<Arc<Self>> {
+        Self::alloc(client, client.global_state, true, [0, 0])
+    }
+
+    /// Links missing tables for `va..va + pages`. The shared L2 of the global state exists.
+    fn ensure_tables(&self, inner: &mut StateInner, va: u64, pages: u64) -> Result {
+        let end = va + (pages << PAGE_SHIFT_UAT) - 1;
+        if !self.global {
+            let mut cur = va >> L1_SHIFT;
+            while cur <= end >> L1_SHIFT {
+                self.ensure_table(inner, 1, cur, cur << L1_SHIFT)?;
+                cur += 1;
+            }
+        }
+        let mut cur = va >> L2_SHIFT;
+        while cur <= end >> L2_SHIFT {
+            self.ensure_table(inner, 2, cur, cur << L2_SHIFT)?;
+            cur += 1;
+        }
+        Ok(())
+    }
+
+    fn ensure_table(&self, inner: &mut StateInner, level: u8, index: u64, va: u64) -> Result {
+        let key = |t: &TableKey| (t.level, t.index);
+        let position = match inner.tables.binary_search_by_key(&(level, index), key) {
+            Ok(_) => return Ok(()),
+            Err(position) => position,
+        };
