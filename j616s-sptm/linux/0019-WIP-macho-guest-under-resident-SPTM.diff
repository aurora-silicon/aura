+/* /sys/kernel/macho_kvm: the late switch. A failure stays here, on the writer's errno and in status. */
+static DEFINE_MUTEX(enable_lock);
+static int enable_result = -EAGAIN;
+
+static ssize_t enable_store(struct kobject *kobj, struct kobj_attribute *attr, const char *buf, size_t n)
+{
+	bool on;
+	int ret = kstrtobool(buf, &on);
+
+	if (ret)
+		return ret;
+	if (!on)
+		return -EINVAL;
+	mutex_lock(&enable_lock);
+	if (enable_result == -EAGAIN)
+		enable_result = kvm_arm_init_late();
+	ret = enable_result;
+	mutex_unlock(&enable_lock);
+	return ret ? ret : n;
+}
+
+static ssize_t status_show(struct kobject *kobj, struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%d\n", enable_result);
+}
+
+static struct kobj_attribute enable_attr = __ATTR_WO(enable);
+static struct kobj_attribute status_attr = __ATTR_RO(status);
+static struct attribute *attrs[] = { &enable_attr.attr, &status_attr.attr, NULL };
+static const struct attribute_group group = { .attrs = attrs };
+
+int kvm_sptm_register_switch(void)
+{
+	struct kobject *k = kobject_create_and_add("macho_kvm", kernel_kobj);
+
+	if (!k)
+		return -ENOMEM;
+	pr_info("kvm: mode sptm, off until /sys/kernel/macho_kvm/enable\n");
+	return sysfs_create_group(k, &group);
+}
