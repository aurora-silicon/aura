+        // An empty pool changes nothing in SPTM: an ordinary error, the state stays usable.
+        let pa = self.client.alloc_frame(subtype)?;
+        let linked = (|| -> Result {
+            self.client
+                .uat(EP_MAP_TABLE, [self.pa, va, level as u64, pa, 0, 0])?;
+            inner
+                .tables
+                .insert_within_capacity(position, TableKey { index, level, pa })
+                .or_else(|_| -> Result {
+                    inner.tables.reserve(16, GFP_KERNEL)?;
+                    inner
+                        .tables
+                        .insert_within_capacity(position, TableKey { index, level, pa })
+                        .map_err(|_| ENOMEM)
+                })
+        })();
+        // Linked and not tracked, or unknown: linking it again would be terminal.
+        if linked.is_err() {
+            inner.failed = true;
+        }
+        linked
+    }
+
+    /// Maps a physical run, or one physical page repeated, at free leaves.
+    pub(crate) fn map(
+        &self,
+        mut va: u64,
+        mut pa: u64,
+        mut pages: u64,
+        one_page: bool,
+        options: u32,
+    ) -> Result {
+        let mut guard = self.inner.lock();
+        let inner = &mut *guard;
+        if inner.failed {
+            return Err(EIO);
+        }
+        self.ensure_tables(inner, va, pages)?;
+        let ret = (|| -> Result {
+            while pages != 0 {
+                let (segments, covered) = if one_page {
+                    let n = pages.min(self.client.segment_limit as u64);
+                    (n, n)
+                } else {
+                    (1, pages)
+                };
+                inner.segments.with_page_mapped(|page| {
+                    let list = page.cast::<MapSegment>();
+                    for i in 0..segments as usize {
+                        let run = MapSegment {
+                            pa,
+                            pages: if one_page { 1 } else { covered },
+                        };
+                        // SAFETY: `segment_limit` entries fit a page: SPTM copies them into the
+                        // rest of its own state page, which is smaller.
+                        unsafe { list.add(i).write(run) };
+                    }
+                });
+                let mut status = self.client.uat(
+                    EP_MAP_BEGIN,
+                    [
+                        self.pa,
+                        va,
+                        inner.segments_ipa,
+                        segments,
+                        options as u64,
+                        0,
+                    ],
+                )?;
+                while status == STATUS_MORE {
+                    status = self.client.uat(EP_MAP_CONTINUE, [self.pa, 0, 0, 0, 0, 0])?;
+                }
+                if !one_page {
+                    pa += covered << PAGE_SHIFT_UAT;
+                }
+                va += covered << PAGE_SHIFT_UAT;
+                pages -= covered;
+            }
+            Ok(())
+        })();
+        if ret.is_err() {
+            inner.failed = true;
+        }
+        ret
+    }
+
+    /// Unmaps a virtual run of present leaves. SPTM invalidates the TLB when a context is set.
+    pub(crate) fn unmap(&self, va: u64, pages: u64) -> Result {
+        let mut guard = self.inner.lock();
+        let inner = &mut *guard;
+        if inner.failed {
+            return Err(EIO);
+        }
+        inner.segments.with_page_mapped(|page| {
+            // SAFETY: One entry fits the page.
+            unsafe { page.cast::<UnmapSegment>().write(UnmapSegment { va, pages }) };
+        });
+        let ret = (|| -> Result {
+            let mut status =
+                self.client
+                    .uat(EP_UNMAP_BEGIN, [self.pa, inner.segments_ipa, 1, 0, 0, 0])?;
+            while status == STATUS_MORE {
+                status = self
+                    .client
+                    .uat(EP_UNMAP_CONTINUE, [self.pa, 0, 0, 0, 0, 0])?;
+            }
+            Ok(())
+        })();
+        if ret.is_err() {
+            inner.failed = true;
+        }
+        ret
+    }
+
+    /// Publishes this state's roots in TTBAT slot `ctx`. Fatal if the slot is valid.
+    pub(crate) fn set_ctx(&self, ctx: u16) -> Result {
+        let mut inner = self.inner.lock();
+        if inner.failed || inner.ctx.is_some() {
+            return Err(EBUSY);
+        }
+        self.client
+            .uat(EP_SET_CTX_ID, [self.pa, ctx as u64, 0, 0, 0, 0])?;
+        inner.ctx = Some(ctx);
+        Ok(())
+    }
+
+    /// The TTBAT slot of this state, if published.
+    pub(crate) fn ctx(&self) -> Option<u16> {
+        self.inner.lock().ctx
+    }
+
+    /// Clears this state's TTBAT slot. SPTM invalidates the context's TLB entries.
+    pub(crate) fn remove_ctx(&self) -> Result {
+        let mut inner = self.inner.lock();
+        if inner.ctx.is_none() {
+            return Ok(());
+        }
+        // The slot stays valid in SPTM: the caller must keep it claimed.
+        if inner.failed {
+            return Err(EIO);
+        }
+        self.client
+            .uat(EP_REMOVE_CTX_ID, [self.pa, 0, 0, 0, 0, 0])?;
+        inner.ctx = None;
+        Ok(())
+    }
+}
+
+#[pinned_drop]
+impl PinnedDrop for State {
+    fn drop(self: Pin<&mut Self>) {
+        if self.global {
+            return;
+        }
+        let client = self.client.clone();
+        let pa = self.pa;
+        let roots = self.roots;
+        let inner = self.inner.lock();
+        if inner.failed {
+            pr_err!("UAT: SPTM state {:#x} retained after a failed call\n", pa);
+            return;
+        }
+        let ret = (|| -> Result {
+            if inner.ctx.is_some() {
+                client.uat(EP_REMOVE_CTX_ID, [pa, 0, 0, 0, 0, 0])?;
+            }
+            // Children first: tables sort by level, so walk from the leaves up.
+            for table in inner.tables.iter().rev() {
+                let shift = if table.level == 1 { L1_SHIFT } else { L2_SHIFT };
+                client.uat(
+                    EP_UNMAP_TABLE,
+                    [pa, table.index << shift, table.level as u64, 0, 0, 0],
+                )?;
+                client.free_frame(table.pa)?;
+            }
+            client.uat(EP_DESTROY_STATE, [pa, 0, 0, 0, 0, 0])?;
+            client.free_frame(roots[0])?;
+            client.free_frame(roots[1])?;
+            client.free_frame(pa)?;
+            Ok(())
+        })();
+        if ret.is_err() {
+            pr_err!("UAT: SPTM state {:#x} teardown failed, retained\n", pa);
+        }
+    }
+}
