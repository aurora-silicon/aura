diff --git c/drivers/pci/controller/pcie-macho-init.c i/drivers/pci/controller/pcie-macho-init.c
new file mode 100644
index 000000000000..23e26fd24b11
--- /dev/null
+++ i/drivers/pci/controller/pcie-macho-init.c
@@ -0,0 +1,570 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+// Copyright The Asahi Linux Contributors: the PCIe port bring-up sequence follows m4-loader src/pcie.c (MIT)
+/*
+ * Late PCIe host init for the J616s Linux guest under the resident SPTM monitor. In the raw boot m4-loader runs this sequence before
+ * Linux (src/pcie.c, pcie_init_controller, APCIE_T8132 with T8122 compat; T6041's ADT says "apcie,t6040"). Under the monitor nothing does:
+ * XNU's driver would, and XNU never runs. All values come from the ADT copy the monitor places in guest RAM. Loaded by hand, late, before
+ * pcie-apple. No register here is SPTM-owned: the monitor's build gate checks each page against the io-range tables.
+ */
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+
+#define PHY_CTRL		0x000
+#define  PHY_CLK0REQ		BIT(0)
+#define  PHY_CLK1REQ		BIT(1)
+#define  PHY_CLK0ACK		BIT(2)
+#define  PHY_CLK1ACK		BIT(3)
+#define  PHY_RESET_T8132	BIT(4)
+#define PHYCMN_CLK		0x000
+#define  PHYCMN_MODE		GENMASK(1, 0)
+#define PORT_LINKSTS		0x208
+#define  PORT_LINKSTS_BUSY	BIT(2)
+#define PORT_APPCLK		0x800
+#define PORT_STATUS		0x804
+#define PORT_RESET_T602X	0x82c
+#define PORT_MSIMAP		0x3800
+#define DWC_DBI_RO_WR		0x8bc
+#define SHARED_REGS		7
+#define POLL_US			250000
+#define PS_BUSY			BIT(11)
+#define AXI2AF_BRIDGE0		0x104	/* XNU's axi2af workaround: base+0x104, base+0x108, base = apcie0 reg 4 */
+#define AXI2AF_BRIDGE1		0x108
+
+/* XNU order (root complex enable): every clock gate but the last, AXI2AF, CIO3PLL, the PLL config,
+ * clkgen bit 5, then the last gate (APCIE_PHY_SW). 0 keeps the raw loader's order: all domains first, PLL only if lost (D6). */
+static bool xnu_order;              /* F34 (S2): XNU's cold boot is the clock enable (8 gates, ADT order) + root complex enable with iBoot's PLL kept:
+                                       that is the loader order; 1 = the wake path (PLL reprogrammed, PHY_SW last) */
+module_param(xnu_order, bool, 0444);
+/* F34 (S2): XNU waits 8 ms for a power state and goes on (panic only with a debug flag); F18 stopped on our hard 250 ms timeout at 0x388 */
+static bool ps_strict;
+module_param(ps_strict, bool, 0444);
+/* F34 (S2): PHY and port values where XNU 26.7.1 differs from m4-loader (the raw link-up proven on this Mac): 1 = XNU's values:
+ * phyP[0] |= bit 27 instead of 0x200, phyIP[0x90] &= ~bit 16, port 0x130 = 0x3020000, 0x13c = 0 */
+static bool xnu_phy;
+module_param(xnu_phy, bool, 0444);
+/* one panel line before each step and a short pause, so a stop shows the step it stopped in */
+static bool steptrace = true;
+module_param(steptrace, bool, 0444);
+
+struct adt_prop { char name[32]; u32 len; u8 val[]; };
+struct adt_node { u32 nprops, nchild; };
+struct tun { u32 off, size; u64 mask, val; } __packed;
+
+struct ctx {
+	struct device *dev;
+	unsigned int step;
+	const u8 *adt;
+	size_t adt_len;
+	const u8 *apcie, *armio;
+	void __iomem *axi;              /* reg 4, for the axi2af bridge bits right after APCIE_SYS_GP (S2 M5) */
+	u64 regs[64];
+	u32 nregs;
+};
+
+static const u8 *next_prop(const u8 *p)
+{
+	const struct adt_prop *a = (const void *)p;
+
+	return p + sizeof(*a) + ALIGN(a->len & 0x7fffffff, 4);
+}
+
+static const void *prop(const u8 *node, const char *name, u32 *len)
+{
+	const struct adt_node *n = (const void *)node;
+	const u8 *p = node + sizeof(*n);
+
+	for (u32 i = 0; i < n->nprops; i++, p = next_prop(p)) {
+		const struct adt_prop *a = (const void *)p;
+
+		if (!strncmp(a->name, name, sizeof(a->name))) {
+			if (len)
+				*len = a->len & 0x7fffffff;
+			return a->val;
+		}
+	}
+	return NULL;
+}
+
+static const u8 *skip_node(const u8 *node)
+{
+	const struct adt_node *n = (const void *)node;
+	const u8 *p = node + sizeof(*n);
+
+	for (u32 i = 0; i < n->nprops; i++)
+		p = next_prop(p);
+	for (u32 i = 0; i < n->nchild; i++)
+		p = skip_node(p);
+	return p;
+}
+
+static const u8 *child(const u8 *node, const char *name)
+{
+	const struct adt_node *n = (const void *)node;
+	const u8 *p = node + sizeof(*n);
+
+	for (u32 i = 0; i < n->nprops; i++)
+		p = next_prop(p);
+	for (u32 i = 0; i < n->nchild; i++, p = skip_node(p)) {
+		const char *nm = prop(p, "name", NULL);
+
+		if (nm && !strcmp(nm, name))
+			return p;
+	}
+	return NULL;
+}
+
+/* /arm-io ranges: <child parent size>, 64 bit each */
+static int translate(struct ctx *c, u64 addr, u64 *pa)
+{
+	u32 len;
+	const u64 *r = prop(c->armio, "ranges", &len);
+
+	for (u32 i = 0; r && i + 3 <= len / 8; i += 3)
+		if (addr >= r[i] && addr < r[i] + r[i + 2]) {
+			*pa = addr - r[i] + r[i + 1];
+			return 0;
+		}
+	return -ENOENT;
+}
+
+static void __iomem *reg_map(struct ctx *c, u32 idx)
+{
+	u32 len;
+	const u64 *r = prop(c->apcie, "reg", &len);
+	u64 pa;
+
+	if (!r || (idx + 1) * 16 > len || translate(c, r[idx * 2], &pa))
+		return NULL;
+	return devm_ioremap(c->dev, pa, r[idx * 2 + 1]);
+}
+
+static int apply(struct ctx *c, const u8 *node, const char *name, void __iomem *base, bool optional)
+{
+	u32 len;
+	const struct tun *t = prop(node, name, &len);
+
+	if (!t) {
+		if (!optional)
+			dev_err(c->dev, "no %s\n", name);
+		return optional ? 0 : -ENOENT;
+	}
+	dev_info(c->dev, "tunables %s: %u\n", name, len / (u32)sizeof(*t));
+	for (u32 i = 0; i < len / sizeof(*t); i++, t++) {
+		void __iomem *a = base + t->off;
+
+		switch (t->size) {
+		case 1: writeb((readb(a) & ~(u8)t->mask) | (u8)t->val, a); break;
+		case 2: writew((readw(a) & ~(u16)t->mask) | (u16)t->val, a); break;
+		case 4: writel((readl(a) & ~(u32)t->mask) | (u32)t->val, a); break;
+		case 8: writeq((readq(a) & ~t->mask) | t->val, a); break;
+		default: return -EINVAL;
+		}
+	}
+	return 0;
+}
+
+static void step(struct ctx *c, const char *what)
+{
+	dev_info(c->dev, "step %u: %s\n", ++c->step, what);
+	if (steptrace)
+		msleep(30);
+}
+
+static void set32(void __iomem *a, u32 v) { writel(readl(a) | v, a); }
+static void clr32(void __iomem *a, u32 v) { writel(readl(a) & ~v, a); }
+static int poll_set(void __iomem *a, u32 m)
+{
+	u32 v;
+
+	return readl_poll_timeout(a, v, (v & m) == m, 10, POLL_US);
+}
+
+static int pwrstates_n(struct device_node *np)
+{
+	struct property *pr = of_find_property(np, "pwrstates", NULL);
+
+	return pr ? pr->length / 8 : 0;
+}
+
+static int axi2af_bridge(struct ctx *c, void __iomem *axi);
+
+/* entries [from, to) of the DT list, in ADT clock-gates order with the parents first */
+static int pwrstates(struct ctx *c, struct device_node *np, int from, int to)
+{
+	for (int i = from; i < to; i++) {
+		u64 pa;
+		u32 v;
+		void __iomem *r;
+		int ret;
+
+		of_property_read_u64_index(np, "pwrstates", i, &pa);
+		r = devm_ioremap(c->dev, pa & ~3ULL, 4);
+		if (!r)
+			return -ENOMEM;
+		/* drivers/pmdomain/apple/pmgr-pwrstate.c: target in [3:0], actual in [7:4], active = 0xf */
+		/* XNU ApplePMGR::_setPSLevel 0x982d7f8: clear AUTO_ENABLE and WAS, wait for actual, then bits 30 and 10.
+		 * A domain that is already on and stays on (PS_AUTO f, as 0x370 = 1f0000ff under the running NVMe) is not touched. */
+		v = readl(r);
+		dev_info(c->dev, "pwrstate %llx was %x\n", pa, v);
+		if ((v & 0xff) == 0xff && !(v & (BIT(30) | BIT(10))) &&
+		    (!(v & BIT(28)) ||
+		     /* LLB leaves AUTO on 0x380..0x398, m4-loader pmgr_set_mode clears it before init */
+		     ((pa < 0x502280380ULL || pa > 0x502280398ULL) &&
+		      (v & GENMASK(27, 24)) == GENMASK(27, 24))))
+			continue;
+		writel((v & ~(BIT(28) | BIT(9) | BIT(8) | 0xfU)) | 0xf, r);
+		ret = readl_poll_timeout(r, v, ((v >> 4) & 0xf) == 0xf, 10, POLL_US);
+		dev_info(c->dev, "pwrstate %llx = %x%s\n", pa, v, ret ? (ps_strict ? " TIMEOUT" : " TIMEOUT, going on as XNU does") : "");
+		if (ret && ps_strict)
+			return ret;
+		if (!ret && (v & (BIT(30) | BIT(10))))
+			writel(v & ~(BIT(30) | BIT(10)), r);
+		/* S2 M5: XNU sets the APCIE_SYS_GP axi2af bridge bits as soon as 0x390 is on, before the ST gates */
+		if ((pa & ~3ULL) == 0x502280390ULL && c->axi) {
+			ret = axi2af_bridge(c, c->axi);
+			if (ret && ps_strict)
+				return ret;
+		}
+	}
+	return 0;
+}
+
+static int phy_clk(void __iomem *phy)
+{
+	set32(phy + PHY_CTRL, PHY_CLK0REQ);
+	if (poll_set(phy + PHY_CTRL, PHY_CLK0ACK))
+		return -ETIMEDOUT;
+	udelay(1);	/* as XNU's PHY init */
+	set32(phy + PHY_CTRL, PHY_CLK1REQ);
+	if (poll_set(phy + PHY_CTRL, PHY_CLK1ACK))
+		return -ETIMEDOUT;
+	return 0;
+}
+
+static int port_init(struct ctx *c, u32 port, u32 per_port, void __iomem *config, const u8 *bridge)
+{
+	u32 base = SHARED_REGS + port * per_port, i, lnk;
+	void __iomem *p = reg_map(c, base), *pp = reg_map(c, base + 2);
+	int ret;
+
+	if (!p || !pp)
+		return -ENOMEM;
+	static const struct { u16 off; u32 v; } w[] = {
+		{0x88, 0x110}, {0x100, 0xffffffff}, {0x148, 0xffffffff}, {0x210, 0xffffffff}, {0x80, 0}, {0x84, 0},
+		{0x104, 0xfffffff0}, {0x124, 0x100}, {0x16c, 0}, {0x13c, 0x10}, {0x800, 0x100100}, {0x808, 0x1000ff}, {0x82c, 0},
+	};
+	for (i = 0; i < ARRAY_SIZE(w); i++)
+		writel(w[i].v, p + w[i].off);
+	for (i = 0; i < 16; i++)
+		writel(0, p + 0x3000 + 4 * i);
+	for (i = 0; i < 512; i++)
+		writel(0, p + PORT_MSIMAP + 4 * i);
+	writel(xnu_phy ? 0x3020000 : 0x3000000, p + 0x130);   /* S2 M3: XNU value 0x3020000; m4-loader 0x3000000 */
+	if (xnu_phy)
+		writel(0, p + 0x13c);                           /* S2 M3b: XNU leaves 0x13c at 0; m4-loader 0x10 */
+	writel(0x10, p + 0x140);
+	writel(0x253770, p + 0x144);
+	writel(0, p + 0x21c);
+	writel(0, p + 0x834);
+	writel(0, p + 0x83c);
+	ret = apply(c, bridge, "apcie-config-tunables", p, false);
+	if (ret)
+		return ret;
+	set32(p + PORT_APPCLK, BIT(0));
+	clr32(pp + PHY_CTRL, PHY_CLK0REQ | PHY_CLK1REQ);
+	ret = phy_clk(pp);
+	if (ret)
+		return ret;
+	clr32(pp + PHY_CTRL, 0x10);
+	set32(pp + PHY_CTRL, 0x200);
+	set32(pp + PHY_CTRL, 0x400);
+	set32(p + PORT_RESET_T602X, BIT(0));
+	if (poll_set(p + PORT_STATUS, BIT(0)))
+		return -ETIMEDOUT;
+	ret = readl_poll_timeout(p + PORT_LINKSTS, lnk, !(lnk & PORT_LINKSTS_BUSY), 10, POLL_US);
+	if (ret)
+		return ret;
+	set32(config + DWC_DBI_RO_WR, BIT(0));
+	ret = apply(c, bridge, "pcie-rc-tunables", config, true) ?:
+	      apply(c, bridge, "pcie-rc-gen3-shadow-tunables", config, true) ?:
+	      apply(c, bridge, "pcie-rc-gen4-shadow-tunables", config, true);
+	if (ret)
+		return ret;
+	/* pcie.c: speed from maximum-link-speed (or the first child's target-link-speed when it says 1), one lane */
+	{
+		const u32 *ms = prop(bridge, "maximum-link-speed", NULL);
+
+		if (ms && *ms) {
+			u32 sp = *ms;
+
+			if (sp == 1) {
+				const struct adt_node *bn = (const void *)bridge;
+				const u8 *q = bridge + sizeof(*bn);
+
+				for (i = 0; i < bn->nprops; i++)
+					q = next_prop(q);
+				if (bn->nchild) {
+					const u32 *t = prop(q, "target-link-speed", NULL);
+
+					if (!t)
+						t = prop(q, "expected-link-speed", NULL);
+					if (t && (int)*t > 0)
+						sp = *t;
+				}
+			}
+			writel((readl(config + 0x70 + 0x0c) & ~GENMASK(3, 0)) | FIELD_PREP(GENMASK(3, 0), sp), config + 0x70 + 0x0c);
+			writel((readl(config + 0x70 + 0x2c) & ~GENMASK(6, 1)) | FIELD_PREP(GENMASK(6, 1), (1 << sp) - 1), config + 0x70 + 0x2c);
+			writew((readw(config + 0x70 + 0x30) & ~GENMASK(3, 0)) | FIELD_PREP(GENMASK(3, 0), sp), config + 0x70 + 0x30);
+			set32(config + 0x80c, BIT(17));
+		}
+	}
+	writel((readl(config + 0x710) & ~GENMASK(21, 16)) | FIELD_PREP(GENMASK(21, 16), 1), config + 0x710);
+	writel((readl(config + 0x80c) & ~GENMASK(12, 8)) | FIELD_PREP(GENMASK(12, 8), 1), config + 0x80c);
+	writel((readl(config + 0x70 + 0x0c) & ~GENMASK(9, 4)) | FIELD_PREP(GENMASK(9, 4), 1), config + 0x70 + 0x0c);
+	clr32(config + DWC_DBI_RO_WR, BIT(0));
+	(void)readl(p + PORT_LINKSTS);
+	dev_info(c->dev, "port %u prepared\n", port);
+	return 0;
+}
+
+/*
+ * T6041 axi2af workaround for APCIE_SYS_GP. XNU's PMGR restore sets bit 0 of
+ * base+0x104 and base+0x108 for every enabled record whose PS target is f (power-up branch); a later
+ * power-up first waits for actual f and bit 11 clear. Record 14 of XNU's workaround table:
+ * map 2, PS 0x390 (APCIE_SYS_GP), base 0x416000000 = apcie0 reg 4. ADT pmgr axi2af-hack = 0x7fff enables all 15.
+ * Nothing on the raw path writes these; if auto-PM gated the domain after LLB, they are 0 here.
+ */
+static int axi2af_bridge(struct ctx *c, void __iomem *axi)
+{
+	void __iomem *ps = devm_ioremap(c->dev, 0x502280390ULL, 4);
+	u32 v, b0, b1;
+	int ret;
+
+	if (!ps)
+		return -ENOMEM;
+	ret = readl_poll_timeout(ps, v, ((v >> 4) & 0xf) == 0xf && !(v & PS_BUSY), 10, POLL_US);
+	b0 = readl(axi + AXI2AF_BRIDGE0);
+	b1 = readl(axi + AXI2AF_BRIDGE1);
+	dev_info(c->dev, "axi2af: ps 0x390 = %x%s, bridge %x %x\n", v, ret ? " NOT READY" : "", b0, b1);
+	if (ret)
+		return ret;
+	writel(b0 | 1, axi + AXI2AF_BRIDGE0);
+	writel(b1 | 1, axi + AXI2AF_BRIDGE1);
+	dev_info(c->dev, "axi2af: bridge now %x %x\n", readl(axi + AXI2AF_BRIDGE0), readl(axi + AXI2AF_BRIDGE1));
+	return 0;
+}
+
+/* XNU root complex enable: CIO3PLL tunables, then the PLL config (PCIECLKGEN tunables, clkgen+4 |= bit 31,
+ * clkgen+0 = (v & ~6) | 1, wait bit 31 = 0), then clkgen+0 |= bit 5. Unconditional in XNU, on cold boot over LLB's PLL as well. */
+static int pll_xnu(struct ctx *c, void __iomem *r5, void __iomem *r6)
+{
+	u32 v;
+	int ret;
+
+	dev_info(c->dev, "cio3pll %x %x, clkgen %x %x before\n", readl(r5), readl(r5 + 4), readl(r6), readl(r6 + 4));
+	ret = apply(c, c->apcie, "apcie-cio3pllcore-tunables", r5, true) ?:
+	      apply(c, c->apcie, "apcie-pcieclkgen-tunables", r6, true);
+	if (ret)
+		return ret;
+	set32(r6 + 4, BIT(31));
+	writel((readl(r6) & ~6U) | 1, r6);
+	ret = readl_poll_timeout(r6, v, !(v & BIT(31)), 10, POLL_US);
+	dev_info(c->dev, "clkgen %x %x after%s\n", readl(r6), readl(r6 + 4), ret ? " TIMEOUT" : "");
+	if (ret)
+		return ret;
+	set32(r6, BIT(5));
+	return 0;
+}
+
+/* LLB programs these once and leaves the domains on AUTO, PS_MIN 0. XNU always redoes them,
+ * the raw loader never. Runs only if the first clkgen tunable is gone. */
+static int clkgen_restore(struct ctx *c, void __iomem *r5, void __iomem *r6)
+{
+	u32 len, v;
+	const struct tun *t = prop(c->apcie, "apcie-pcieclkgen-tunables", &len);
+	int ret;
+
+	if (!t || len < sizeof(*t) || (readl(r6 + t->off) & (u32)t->mask) == (u32)t->val)
+		return 0;
+	dev_warn(c->dev, "clkgen lost: %x %x, reprogramming\n", readl(r6), readl(r6 + 4));
+	ret = apply(c, c->apcie, "apcie-cio3pllcore-tunables", r5, true) ?:
+	      apply(c, c->apcie, "apcie-pcieclkgen-tunables", r6, false);
+	if (ret)
+		return ret;
+	/* the PLL config, then clkgen bit 5 */
+	set32(r6 + 4, BIT(31));
+	writel((readl(r6) & ~6U) | 1, r6);
+	ret = readl_poll_timeout(r6, v, !(v & BIT(31)), 10, POLL_US);
+	if (ret)
+		return ret;
+	set32(r6, BIT(5));
+	return 0;
+}
+
+static int macho_pcie_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *adt_np;
+	struct resource r;
+	struct ctx *c;
+	void __iomem *config, *rc, *phy, *phyb, *phyc, *ip, *axi;
+	const u32 *ports;
+	u32 rl, phy_i;
+	int ret, per_port, npw;
+
+	c = devm_kzalloc(dev, sizeof(*c), GFP_KERNEL);
+	if (!c)
+		return -ENOMEM;
+	c->dev = dev;
+	adt_np = of_parse_phandle(dev->of_node, "adt", 0);
+	if (!adt_np || of_address_to_resource(adt_np, 0, &r))
+		return -ENODEV;
+	c->adt_len = resource_size(&r);
+	c->adt = devm_memremap(dev, r.start, c->adt_len, MEMREMAP_WB);
+	if (IS_ERR(c->adt))
+		return PTR_ERR(c->adt);
+	c->armio = child(c->adt, "arm-io");
+	c->apcie = c->armio ? child(c->armio, "apcie0") : NULL;
+	if (!c->apcie)
+		return dev_err_probe(dev, -ENODEV, "no /arm-io/apcie0 in the ADT copy\n");
+	ports = prop(c->apcie, "#ports", NULL);
+	if (!prop(c->apcie, "reg", &rl) || !ports || !*ports)
+		return -EINVAL;
+	per_port = (rl / 16 - SHARED_REGS) / *ports;
+	config = reg_map(c, 0);
+	rc = reg_map(c, 1);
+	phy = reg_map(c, 2);
+	ip = reg_map(c, 3);
+	axi = reg_map(c, 4);
+	if (!config || !rc || !phy || !ip || !axi)
+		return -ENOMEM;
+	c->axi = axi;
+	npw = pwrstates_n(dev->of_node);
+	if (xnu_order) {
+		u64 last = 0;
+
+		of_property_read_u64_index(dev->of_node, "pwrstates", npw - 1, &last);
+		if (npw < 2 || last != 0x502280398ULL) {
+			dev_warn(dev, "last pwrstate %llx is not APCIE_PHY_SW, loader order\n", last);
+			xnu_order = false;
+		}
+	}
+	/* the last DT entry is APCIE_PHY_SW, the last ADT clock gate: XNU turns it on only after the PLL */
+	step(c, xnu_order ? "power domains but the PHY" : "power domains");
+	ret = pwrstates(c, dev->of_node, 0, xnu_order && npw > 1 ? npw - 1 : npw);
+	if (ret)
+		return dev_err_probe(dev, ret, "power domains\n");
+	/* m4-loader pcie.c: T8122 compat coalesces common and PHY 0 into reg[2]; tunables stay on reg[2] */
+	phyc = phy + 0x4000;
+	phyb = phy + 0x8000;
+	step(c, "axi2af bridge bits (XNU restore order)");
+	ret = axi2af_bridge(c, axi);
+	if (ret)
+		return dev_err_probe(dev, ret, "axi2af bridge\n");
+	step(c, "axi2af tunables");
+	ret = apply(c, c->apcie, "apcie-axi2af-tunables", axi, true);
+	if (ret)
+		return ret;
+	/* reg 5 CIO3PLL, reg 6 clkgen. XNU always programs them here; the raw loader never does, LLB did */
+	{
+		void __iomem *r5 = reg_map(c, 5), *r6 = reg_map(c, 6);
+
+		if (!r5 || !r6)
+			return dev_err_probe(dev, -ENOMEM, "no CIO3PLL or clkgen reg\n");
+		step(c, xnu_order ? "PLL (XNU wake order)" : "PLL if lost");
+		if (xnu_order) {
+			ret = pll_xnu(c, r5, r6);
+		} else {
+			dev_info(dev, "cio3pll %x %x, clkgen %x %x\n", readl(r5), readl(r5 + 4), readl(r6), readl(r6 + 4));
+			ret = clkgen_restore(c, r5, r6);
+		}
+		if (ret)
+			return dev_err_probe(dev, ret, "PCIe PLL\n");
+	}
+	if (xnu_order && npw > 1) {
+		step(c, "power domain APCIE_PHY_SW");
+		ret = pwrstates(c, dev->of_node, npw - 1, npw);
+		if (ret)
+			return dev_err_probe(dev, ret, "APCIE_PHY_SW\n");
+	}
+	step(c, "common and PHY tunables");
+	/* m4-loader pcie.c:429-443: after axi2af, before common */
+	writel(0, rc + 0x4);
+	ret = apply(c, c->apcie, "apcie-common-tunables", rc, true) ?:
+	      apply(c, c->apcie, "apcie-phy-tunables", phy, true);
+	if (ret)
+		return ret;
+	/* XNU root complex enable: refpll_clk_good, PhyCommon(0) bit 31, before the PHY init. XNU spins for ever; here a
+	 * missing bit is only reported, the CLK0/CLK1 acks below fail on their own if the reference clock is really absent */
+	step(c, "refpll_clk_good");
+	{
+		u32 v;
+
+		ret = readl_poll_timeout(phyc, v, v & BIT(31), 10, POLL_US);
+		dev_info(dev, "phy common %x%s\n", v, ret ? " refpll_clk_good NOT SET" : "");
+	}
+	/* one PHY at phy_base + 0, as the J616s ADT names no per-PHY tables when num_phys is 1 (pcie.c:505-512) */
+	for (phy_i = 0; phy_i < 1; phy_i++) {
+		step(c, "PHY clocks");
+		ret = phy_clk(phyb);
+		if (ret)
+			return dev_err_probe(dev, ret, "PHY clock, ctrl %x\n", readl(phyb + PHY_CTRL));
+		step(c, "PHY IP tunables");
+		clr32(phyb + PHY_CTRL, PHY_RESET_T8132);
+		udelay(1);
+		writel(readl(phyb + 4) | 1, phyb + 4);
+		ret = apply(c, c->apcie, "apcie-phy-ip-pll-tunables", ip, false) ?:
+		      apply(c, c->apcie, "apcie-phy-ip-auspma-tunables", ip, false);
+		if (ret)
+			return ret;
+		if (xnu_phy)
+			clr32(ip + 0x90, BIT(16));                      /* S2 M2: XNU between the AUSPMA tunables and phyP[4] |= 0x10 */
+		writel(readl(phyb + 4) | 0x10, phyb + 4);
+	}
+	step(c, "PHY common mode, max_pclk_good");
+	writel((readl(phyc + PHYCMN_CLK) & ~PHYCMN_MODE) | FIELD_PREP(PHYCMN_MODE, 1), phyc + PHYCMN_CLK);
+	if (poll_set(phyb + 0x8, 1))
+		return dev_err_probe(dev, -ETIMEDOUT, "PHY clock enable, %x\n", readl(phyb + 0x8));
+	set32(phyb + PHY_CTRL, xnu_phy ? BIT(27) : 0x200);      /* S2 M1: XNU sets bit 27; m4-loader 0x200 (raw link-up on this Mac) */
+	step(c, "RC init, gtb_initialized");
+	writel(0x140, rc + 0x54);
+	writel(1, rc + 0x50);
+	if (poll_set(rc + 0x58, 1))
+		return dev_err_probe(dev, -ETIMEDOUT, "RC init, %x\n", readl(rc + 0x58));
+	for (u32 port = 0; port < *ports; port++) {
+		char name[16];
+		const u8 *bridge;
+
+		snprintf(name, sizeof(name), "pci-bridge%u", port);
+		bridge = child(c->apcie, name);
+		if (!bridge)
+			continue;
+		step(c, name);
+		ret = port_init(c, port, per_port, config + ((resource_size_t)port << 15), bridge);
+		if (ret)
+			return dev_err_probe(dev, ret, "port %u\n", port);
+	}
+	dev_info(dev, "host prepared, pcie-apple may load\n");
+	return 0;
+}
+
+static const struct of_device_id macho_pcie_of[] = {
+	{ .compatible = "omarchy-m4,pcie-init" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, macho_pcie_of);
+
+static struct platform_driver macho_pcie_driver = {
+	.probe = macho_pcie_probe,
+	.driver = { .name = "pcie-macho-init", .of_match_table = macho_pcie_of },
+};
+module_platform_driver(macho_pcie_driver);
+MODULE_DESCRIPTION("J616s PCIe host init under the SPTM monitor (port of m4-loader pcie.c)");
+MODULE_LICENSE("Dual MIT/GPL");
