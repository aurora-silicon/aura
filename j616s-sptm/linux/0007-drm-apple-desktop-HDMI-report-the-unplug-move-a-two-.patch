 drivers/gpu/drm/apple/dcp-internal.h     |  5 ++
 drivers/gpu/drm/apple/dcp-peer-v26_6.inc |  2 +
 drivers/gpu/drm/apple/dcp.c              | 32 +++++++---
 drivers/gpu/drm/apple/dcp.h              |  1 +
 5 files changed, 108 insertions(+), 10 deletions(-)

