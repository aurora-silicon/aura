--- /dev/null
+++ b/Documentation/devicetree/bindings/nvme/apple,nvme-apif.yaml
@@ -0,0 +1,79 @@
+# SPDX-License-Identifier: GPL-2.0-only
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/nvme/apple,nvme-apif.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Resident Apple ANS controller using the Aurora platform interface
+
+maintainers:
+  - Dj <hey@djdev.me>
+
+description: |
+  A boot-time guest description for the native table-6 ABI with 64-entry
+  linear queues. The producer stops all NVMe DMA and quiesces both sides
+  of RTKit before handoff. Native queue registrations survive controller
+  disable, so the consumer must reuse the four registered queue pages.
+  This binding describes an ABI, not a promise of support for every SoC.
+  The controller uses identity DMA addresses and coherent shared memory.
+
+properties:
+  compatible:
+    const: apple,nvme-apif
+  reg:
+    items:
+      - description: NVMe controller registers
+      - description: ANS coprocessor control registers
+  reg-names:
+    items:
+      - const: nvme
+      - const: ans
+  interrupts:
+    maxItems: 1
+  mboxes:
+    maxItems: 1
+  apple,sart:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: SART provider for the resident controller
+  aurora,apif:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Version-2 native APIF transport
+  dma-coherent: true
+  asahi,rtkit-quiesced:
+    type: boolean
+    description: Both RTKit peers were stopped before their buffers were released
+  memory-region:
+    minItems: 4
+    maxItems: 4
+  memory-region-names:
+    items:
+      - const: admin-sq
+      - const: admin-cq
+      - const: io-sq
+      - const: io-cq
+  power-domains:
+    minItems: 2
+    maxItems: 3
+  power-domain-names:
+    minItems: 2
+    items:
+      - const: ans
+      - const: apcie0
+      - enum: [apcie1, apcie_phy]
+  resets:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - mboxes
+  - apple,sart
+  - aurora,apif
+  - dma-coherent
+  - asahi,rtkit-quiesced
+  - memory-region
+  - memory-region-names
+
+additionalProperties: false
