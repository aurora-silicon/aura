+++ b/drivers/hwmon/Kconfig
@@ -1252,10 +1252,13 @@ config SENSORS_MACSMC_HWMON_KUNIT_TEST
 	depends on SENSORS_MACSMC_HWMON && KUNIT=y
 	default KUNIT_ALL_TESTS
 	help
-	  Unit tests for the channel numbering of the Apple SMC hwmon driver.
+	  Unit tests for the channel numbering and the manual fan control of
+	  the Apple SMC hwmon driver.
 	  Thermal zones refer to temperature channels by index, so a sensor
