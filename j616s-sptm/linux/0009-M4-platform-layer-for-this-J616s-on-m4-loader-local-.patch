diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index ab61aa391c55..1f2137d13740 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -321,6 +321,11 @@ struct apple_dart {
 	DECLARE_BITMAP(remapped, DART_MAX_STREAMS);
 	u8 remap_target[DART_MAX_STREAMS];
 
+	/* address filter window and its "apple,dapf-entries" tuples */
+	void __iomem *dapf;
+	u64 *dapf_entries;
+	unsigned int dapf_count;
+
 	dma_addr_t dma_min;
 	dma_addr_t dma_max;
 	dma_addr_t dma_offset;
@@ -1609,6 +1614,73 @@ static int apple_dart_read_remaps(struct apple_dart *dart)
 	return 0;
 }
 
+/*
+ * The DART's address filter (DAPF), the block of the second reg: one 0x40-byte
+ * entry per "apple,dapf-entries" tuple <start end r0 r4 r20> (64-bit cells, as
+ * the ADT's filter data). The T6040 AOP firmware stops on a fault storm without it.
+ */
+#define DART_DAPF_ENTRY_SIZE	0x40
+
+static int apple_dart_write_dapf(struct apple_dart *dart)
+{
+	unsigned int i, bad = 0;
+
+	for (i = 0; i < dart->dapf_count; i++) {
+		void __iomem *r = dart->dapf + i * DART_DAPF_ENTRY_SIZE;
+		const u64 *e = &dart->dapf_entries[i * 5];
+
+		writel(e[3], r + 0x04);
+		writeq(e[0], r + 0x08);
+		writeq(e[1], r + 0x10);
+		writel(e[2], r + 0x00);
+		writel(e[4], r + 0x20);
+		/* the end address keeps only word granularity: its low two bits read back set */
+		if (readl(r + 0x04) != e[3] || readq(r + 0x08) != e[0] ||
+		    (readq(r + 0x10) | 3) != (e[1] | 3) ||
+		    (readl(r + 0x00) & 0xff) != e[2] || readl(r + 0x20) != e[4])
+			bad++;
+	}
+	if (bad) {
+		dev_err(dart->dev, "DAPF: %u of %u entries did not read back\n", bad,
+			dart->dapf_count);
+		return -EIO;
+	}
+	return 0;
+}
+
+/* Keep the entries: a DART that loses power loses them, see apple_dart_resume(). */
+static int apple_dart_init_dapf(struct platform_device *pdev, struct apple_dart *dart)
+{
+	struct device_node *np = pdev->dev.of_node;
+	const char *prop = "apple,dapf-entries";
+	struct resource *res;
+	int count, ret;
+
+	count = of_property_count_u64_elems(np, prop);
+	if (count <= 0)
+		return 0;
+	if (count % 5)
+		return -EINVAL;
+	dart->dapf = devm_platform_get_and_ioremap_resource(pdev, 1, &res);
+	if (IS_ERR(dart->dapf))
+		return PTR_ERR(dart->dapf);
+	if (count / 5 * DART_DAPF_ENTRY_SIZE > resource_size(res))
