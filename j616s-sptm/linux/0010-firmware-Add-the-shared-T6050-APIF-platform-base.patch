diff --git a/Documentation/devicetree/bindings/firmware/aurora,apif-mmio.yaml b/Documentation/devicetree/bindings/firmware/aurora,apif-mmio.yaml
new file mode 100644
index 000000000000..c154786a0593
--- /dev/null
+++ b/Documentation/devicetree/bindings/firmware/aurora,apif-mmio.yaml
@@ -0,0 +1,36 @@
+# SPDX-License-Identifier: GPL-2.0-only
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/firmware/aurora,apif-mmio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Aurora Platform Interface over Memory-Mapped I/O
+
+maintainers:
+  - Dj <hey@djdev.me>
+
+description: |
+  Synthetic MMIO transport supplied by Aura's EL2-resident monitor. Version 2
+  forwards native SPTM selectors and arguments and provides memory-ownership
+  services. Peripheral policy belongs to consumers, which reference this node
+  through the aurora,apif phandle. The register page must be absent from the
+  guest stage-2 mappings so accesses reach Aura.
+
+properties:
+  compatible:
+    const: aurora,apif-mmio
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    apif: firmware@61ff0000 {
+        compatible = "aurora,apif-mmio";
+        reg = <0x61ff0000 0x4000>;
+    };
diff --git a/Documentation/devicetree/bindings/iommu/apple,dart-apif.yaml b/Documentation/devicetree/bindings/iommu/apple,dart-apif.yaml
new file mode 100644
index 000000000000..dbf1169dae26
--- /dev/null
+++ b/Documentation/devicetree/bindings/iommu/apple,dart-apif.yaml
@@ -0,0 +1,84 @@
+# SPDX-License-Identifier: GPL-2.0-only
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iommu/apple,dart-apif.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple DART mediated through Aura APIF
+
+maintainers:
+  - Dj <hey@djdev.me>
+
+description: |
+  A DART instance accessed through native SPTM calls rather than guest MMIO.
+  Linux owns stream grouping, table setup, mapping rollback and DMA apertures.
+  Firmware-owned streams are adopted without replacing their roots or replaying
+  retained mappings. Unit identifiers are firmware metadata, not chip IDs.
+
+properties:
+  compatible:
+    const: apple,dart-apif
+  '#iommu-cells':
+    const: 1
+    description: Stream identifier.
+  aurora,apif:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: APIF version-2 transport provider.
+  power-domains:
+    maxItems: 1
+    description: |
+      Native register-clock dependency needed before the first APIF DART call.
+      The provider must be powered independently of consumer probe ordering.
+      For T6050 ATC2 USB DART this is the ATC2_USB domain shared with DWC3.
+  apple,apif-dart-id:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 255
+    description: Native SPTM DART unit identifier.
+  apple,apif-num-streams:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    minimum: 1
+    maximum: 256
+    default: 256
+    description: Number of streams supported by this unit.
+  apple,apif-retained-sids:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 1
+    maxItems: 256
+    uniqueItems: true
+    items:
+      maximum: 255
+    description: Firmware-owned stream IDs which Aura adopted at bootstrap.
+  apple,apif-iova-force:
+    $ref: /schemas/types.yaml#/definitions/uint64
+    enum: [0, 1099511627776]
+    description: |
+      Optional native bit-40 force mask for a low-address device DMA view.
+      Must not overlap apple,dma-range. Omit for a native DVA aperture.
+  apple,apif-reserve-last-page:
+    type: boolean
+    description: Native aperture forbids allocating its final 16 KiB granule.
+  apple,dma-range:
+    $ref: /schemas/types.yaml#/definitions/uint64-array
+    minItems: 2
+    maxItems: 2
+    description: |
+      Device-visible DMA aperture base and size, aligned to 16 KiB and within
+      42 bits. Defaults to the low 4 GiB. This is not a CPU mapping.
+
+required:
+  - compatible
+  - '#iommu-cells'
+  - aurora,apif
+  - apple,apif-dart-id
+
+additionalProperties: false
+
+examples:
+  - |
+    iommu {
+        compatible = "apple,dart-apif";
+        #iommu-cells = <1>;
+        aurora,apif = <&apif>;
+        apple,apif-dart-id = <5>;
+        apple,apif-num-streams = <16>;
+    };
