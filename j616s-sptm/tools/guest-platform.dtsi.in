// SPDX-License-Identifier: GPL-2.0-only
// generated by tools/gen-guest-platform.py from the running J616s DT: holds this unit's calibration, never commit the output
	pcie_init: pcie-macho-init {
		compatible = "omarchy-m4,pcie-init";
		adt = <&apple_adt>;
		// ADT clock-gates with parents: afc fab3_soc ans apcie_gp apcie_sys_gp apcie_st0 apcie_sys_st0 apcie_st1 apcie_sys_st1 apcie_phy_sw
		pwrstates = <0x5 0x2800178>, <0x5 0x2280118>, <0x5 0x2280370>, <0x5 0x2280100>, <0x5 0x2280390>, <0x5 0x2280108>, <0x5 0x2280380>, <0x5 0x2280110>, <0x5 0x2280388>, <0x5 0x2280398>;
	};
@OPP@	pinctrl: pinctrl@51c000000 {
		compatible = "apple,t6041-pinctrl", "apple,t8103-pinctrl";
		reg = <0x5 0x1c000000 0x0 0x4000>;
		gpio-controller; #gpio-cells = <2>; gpio-ranges = <&pinctrl 0 0 200>; apple,npins = <200>;
		wifi_clkreq_pins: wifi-clkreq-pins { pinmux = <0x00010000>; };
	};
	pcie_dart: iommu@410000000 {
		compatible = "apple,dart-apif";
		#iommu-cells = <1>;
		aurora,apif = <&apif>;
		apple,apif-dart-id = <0xba5e0403>;   // live ADT dart-apcie0
		apple,apif-num-streams = <19>;       // ADT sid-count
		apple,dma-range = <0x100 0x100000 0x0 0x3fe00000>;   // ADT vm-base, vm-size; monitor checks them
		apple,apif-reserve-last-page;   // SPTM MAP: (dva+size)>>14 must stay below the end page
		status = "mhold-pci";
	};
	pcie0: pcie@1cb0000000 {
		compatible = "apple,t6041-pcie", "apple,t6020-pcie";
		reg = <0x1c 0xb0000000 0x0 0x1000000>, <0x4 0x14000000 0x0 0x4000>, <0x4 0x10028000 0x0 0x4000>, <0x4 0x11028000 0x0 0x4000>,
		      <0x4 0x12028000 0x0 0x4000>, <0x4 0x13028000 0x0 0x4000>, <0x4 0x17020000 0x0 0x4000>, <0x4 0x17024000 0x0 0x4000>,
		      <0x4 0x17028000 0x0 0x4000>, <0x4 0x1702c000 0x0 0x4000>;
		reg-names = "config", "rc", "port0", "port1", "port2", "port3", "phy0", "phy1", "phy2", "phy3";
		ranges = <0x02000000 0x0 0x80000000 0xb 0x80000000 0x0 0x40000000>;
		pinctrl-names = "default"; pinctrl-0 = <&wifi_clkreq_pins>;
		#size-cells = <2>; #address-cells = <3>;
		bus-range = <0 1>;
		iommu-map-mask = <0xffff>;
		iommu-map = <0x100 &pcie_dart 1 2>;   // as the running raw DT; ADT 17 is apcie-piodma-sid
		msi-ranges = <&aic 0 2071 1 32>;
		msi-parent = <&pcie0>;
		msi-controller;
		interrupts = <0 0x6bb 4>;
		interrupt-parent = <&aic>;
		device_type = "pci";
		// pcie-apple is a module here: nothing touches this host until the late service loads pcie-macho-init, then pcie-apple
		port00: pci@0,0 {
			compatible = "pciclass,0604"; reg = <0 0 0 0 0>; ranges;
			interrupt-map-mask = <0 0 0 7>; #interrupt-cells = <1>; interrupt-controller;
			interrupt-map = <0 0 0 1 &port00 0 0 0 0>, <0 0 0 2 &port00 0 0 0 1>, <0 0 0 3 &port00 0 0 0 2>, <0 0 0 4 &port00 0 0 0 3>;
			#size-cells = <2>; #address-cells = <3>;
			pwren-gpios = <&smc_gpio 0x13 0>;
			reset-gpios = <&pinctrl 4 1>;
			device_type = "pci";
			// F35: Bluetooth, the second function of the BCM4388 behind the same dart-apcie0 stream the monitor already admits (daily DT node)
			bluetooth@0,1 {
				compatible = "pci14e4,5f72";
				reg = <0x100 0 0 0 0>;
// Bluetooth calibration: what the daily loader hands hci_bcm4377 at boot, read from the running DT by gen-guest-platform.py
// (bluetooth-taurus-calibration-bf -> brcm,taurus-bf-cal-blob, bluetooth-taurus-calibration -> brcm,taurus-cal-blob, local-mac-address -> local-bd-address)
				local-bd-address = [@BTADDR@];
				brcm,taurus-bf-cal-blob = [@BTBFCAL@];
				brcm,taurus-cal-blob = [@BTCAL@];
				brcm,board-type = "apple,hostomel";
				apple,m4-bt-otp-probe;
				apple,m4-bt-admission-policy = "runtime-after-cold-reset-v1";
			};
			wifi@0,0 { compatible = "brcm,bcm4329-fmac"; reg = <0 0 0 0 0>; brcm,ccode-map-trivial; brcm,board-type = "apple,hostomel"; apple,antenna-sku = "@SKU@"; brcm,cal-blob = [@CAL@]; };
		};
	};
