fi
# F36 fluent: everything the staged boots proved (F34 11-02, F35 x3) comes up here, before the root, so the desktop starts once, on the
# panel's own card and the GPU: the other nine cores, WFI idle + cpufreq, the DART units, keyboard/trackpad, DCP, asahi.
flu=; grep -qw macho.fluent /proc/cmdline && flu=1
dart_unit_up() {   # dart_unit_up <addr> <tag>: one apple,dart-apif unit by name (as the root's macho-late-load dart-unit)
  [ "$(tr '\0' '\n' < /sys/firmware/devicetree/base/iommu@$1/status 2>/dev/null | head -n1)" = okay ] || { say "$2: iommu@$1 not enabled by the monitor"; return 1; }
