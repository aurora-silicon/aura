cat > /new/usr/local/bin/macho-late-load <<'S'
#!/bin/bash
M=/usr/lib/modules/7.3.0-m4.macho
L=/run/macho-status.log
line() { echo "LATE: $1" | tee -a $L > /dev/kmsg; }
load() {
  [ -f "$M/$1.ko" ] || { line "$1 not in the image"; return 1; }
  line "insmod $*"
  # a task in D holds a plain timeout for ever, and the steps after it with it
  timeout 30 insmod "$M/$1.ko" ${2:-} & p=$!
  i=0; while kill -0 $p 2>/dev/null && [ $i -lt 40 ]; do sleep 1; i=$((i+1)); done
  if kill -0 $p 2>/dev/null; then line "$1 still in insmod after 40 s: $(for c in $(pgrep -x insmod); do head -n3 /proc/$c/stack 2>/dev/null; done | tr '\n' ' ')"; return 1; fi
  wait $p; rc=$?
  line "$1 rc=$rc $(dmesg | tail -n 1 | cut -c1-120)"
  sleep 3
  return $rc
}
on() { [ "$(tr '\0' '\n' < "/sys/firmware/devicetree/base/$1/status" 2>/dev/null | head -n1)" = okay ]; }
case "$1" in
dart)
  # the PCIe unit alone first: Wi-Fi carries the log and the shell of every later step, and a stop in another unit's INIT cannot take it.
  # apif_only matches the platform device name. A DART node with reg is "410000000.iommu" (raw DT); the guest nodes have no reg, so the
  # name is the node name "iommu@410000000" (of_device_make_bus_id, HW F26). A list without it defers the unit for ever. Both are listed.
  [ -e /sys/module/apple_dart_apif ] || "$0" dart-driver
  [ -e /sys/bus/platform/drivers/apple-dart-apif/iommu@410000000 ] || ! on iommu@410000000 || "$0" dart-unit iommu@410000000
  ;;
dart-driver)
  on iommu@514800000 || on iommu@402340000 || on iommu@410000000 || { line "no DART nodes enabled by the monitor"; exit 0; }
  # "none" matches no unit (apple-dart-apif.c strstr): each is added by name in its own step
  line "insmod apple-dart-apif apif_only=none"; timeout 30 insmod "$M/apple-dart-apif.ko" apif_only=none; line "apple-dart-apif rc=$?"
  ;;
dart-unit)
  # One unit, named: "echo >" stores "\n", not an empty string, and every unit would keep deferring (KVM 11-01). A truly empty list would let the next bind probe all the others.
  # A master probed before its unit gets no IOMMU at all (DRIVER_DEFERRED_PROBE_TIMEOUT=0, HW F26 dwc3-apple), so the caller stops here if the unit is not bound.
  [ -e "/sys/bus/platform/devices/$2" ] || { line "$2: no such device"; exit 1; }
  p=/sys/module/apple_dart_apif/parameters/apif_only
  ( flock 9; echo "$(cat $p),$2" > $p ) 9>/run/macho-dart.lock    # macho-net and the sequencer can both be here
  line "probe $2"; echo "$2" > /sys/bus/platform/drivers_probe; sleep 3
  [ -e "/sys/bus/platform/drivers/apple-dart-apif/$2" ] || { line "$2 not bound"; exit 1; }
  line "$2 bound"
  ;;
display)
  on dcp@402e00000 || { line "DCP stays off (monitor kept the node), simple framebuffer stays"; exit 0; }
  # first table 3 calls on the live scanout: a stop after these lines is INIT or POWERUP of that unit
  "$0" dart-unit iommu@402340000 && "$0" dart-unit iommu@402300000 || { line "DCP DART not up, simpledrm stays"; exit 0; }
  # internal panel only: the guest DT has no dcpext nodes. A takeover the driver refuses leaves simpledrm on the screen.
  load drm_dma_helper; load dcp-fabric-core; load appledrm t6041_dcpext=0
  ls /sys/class/drm | tr '\n' ' ' | sed 's/^/LATE: drm /' > /dev/kmsg
  ;;
input)
  on mtp@514600000 || { line "MTP stays off (monitor kept the node)"; exit 0; }
  "$0" dart-unit iommu@514800000 || { line "MTP DART not up, input skipped"; exit 0; }
  for m in apple-dockchannel apple-rtkit-helper; do load "$m" || exit 0; done
  line "mtp driver $(ls -l /sys/bus/platform/devices/514600000.mtp/driver 2>/dev/null | sed 's/.*-> //')"
  load dockchannel-hid
  sleep 5
  line "input: $(grep -h Name= /proc/bus/input/devices | cut -d= -f2 | tr '\n' ';')"
  ;;
esac
S
