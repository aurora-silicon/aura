}
ins() { [ -f /lib/modules/$1.ko ] || { say "FLUENT: $1 not in the initrd"; return 1; }; insmod /lib/modules/$1.ko $2 2>/dev/kmsg; say "FLUENT: insmod $1 rc=$?"; }
fluent_up() {
  say "FLUENT: the other nine cores"; smp_early rest
  if [ -e /sys/module/idle/parameters/mode ]; then echo wfi > /sys/module/idle/parameters/mode; say "FLUENT: idle WFI"; fi
  ins apple-soc-cpufreq; for g in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do [ -e "$g" ] && echo schedutil > "$g"; done
  ins macsmc-power
  say "FLUENT: input"
  if dart_unit_up 514800000 MTP; then ins apple-dockchannel; ins apple-rtkit-helper; ins dockchannel-hid; fi
  say "FLUENT: display (DCP takes the panel from simplefb)"
  if dart_unit_up 402340000 DCP && dart_unit_up 402300000 DISP; then
    ins drm_dma_helper; ins dcp-fabric-core; ins appledrm t6041_dcpext=0
    i=0; while [ ! -e /dev/dri/by-path/platform-display-subsystem-card ] && [ $i -lt 30 ]; do sleep 1; i=$((i+1)); done
    say "FLUENT: display card $(ls /dev/dri/by-path 2>/dev/null | tr '\n' ' ') after ${i}s"
  fi
  say "FLUENT: gpu"; ins asahi
  i=0; while [ ! -e /dev/dri/renderD128 ] && [ $i -lt 30 ]; do sleep 1; i=$((i+1)); done
  say "FLUENT: render node $(ls /dev/dri 2>/dev/null | tr '\n' ' ') after ${i}s, $(cat /sys/devices/system/cpu/online) online, $(temp_max) mC"
  # F36.1: no runtime suspend of the panel pipe or the GPU: DPMS-off / idle power-down of DCP and asahi never ran under the monitor
  # (F36 HW 11-02 froze at 261 s, about 150 s after the session started = Omarchy's screensaver timeout)
  for d in /sys/bus/platform/devices/402e00000.dcp /sys/bus/platform/devices/28a600000.gpu /sys/bus/platform/devices/402300000.iommu /sys/bus/platform/devices/402340000.iommu; do [ -e $d/power/control ] && echo on > $d/power/control; done
  say "FLUENT: runtime PM: dcp $(cat /sys/bus/platform/devices/402e00000.dcp/power/control 2>/dev/null) gpu $(cat /sys/bus/platform/devices/28a600000.gpu/power/control 2>/dev/null)"
}
if [ -n "$fin" ]; then
  draw=final
  say "ORDER: final io wifi, then the root and the desktop; the sequencer runs input smp dispgpu late kvmon litmus1 (F34 HW 11-02)"
  say "STEP: io"; bounded USB-A 40 usb_acm_up    # ACM shell + ACM log, the debug link of every later step (EEM: /macho-eem-up)
  step_wifi
  [ -n "$flu" ] && { say "STEP: fluent"; bounded FLUENT 150 fluent_up; }
fi
case $draw in
0) say "ORDER: 0 usb wifi tso kvm"; step_usb; step_wifi; step_tso; step_kvm ;;
1) say "ORDER: 1 tso kvm usb wifi"; step_tso; step_kvm; step_usb; step_wifi ;;
2) say "ORDER: 2 wifi usb kvm tso"; step_wifi; step_usb; step_kvm; step_tso ;;
3) say "ORDER: 3 none, all left to the sequencer" ;;
esac
found=
for i in $(seq 1 3000); do
    [ -b /dev/nvme0n1p3 ] && { found=1; break; }
    wait10ms
done
if [ -z "$found" ]; then
    say "NVME: no root partition after 30 s, holding"
    while :; do sleep 30; say "HB up=$(cut -d' ' -f1 /proc/uptime) ticks=$(ticks)"; done
fi
say "NVME: controller up, partitions present"
hold_forever() { say "$1, holding"; while :; do sleep 30; say "HB up=$(cut -d' ' -f1 /proc/uptime) ticks=$(ticks)"; done; }
# F35: the first writes under SPTM go to the empty scratch slot p5 (1 MiB window at +1 GiB, saved and put back byte for byte),
# never to the root: the root is mounted read-write only when they verify, else the boot falls back to read-only + overlay.
nvme_write_gate() {
  P=/dev/nvme0n1p5; OFF=262144; W=/run/nwt; rc=0
  mkdir -p $W
  [ "$(cat /sys/block/nvme0n1/nvme0n1p5/start 2>/dev/null)" = 1926947192 ] && [ "$(cat /sys/block/nvme0n1/nvme0n1p5/size 2>/dev/null)" = 16777216 ] || { say "NVME-WT: p5 geometry unexpected, no writes"; return 1; }
  dd if=$P of=$W/orig bs=4096 skip=$OFF count=256 iflag=direct 2>/dev/null || { say "NVME-WT: backup read failed"; return 1; }
  blockdev --setrw /dev/nvme0n1; blockdev --setrw $P
  d0=$(dmesg | wc -l)
  for kb in 4 64 1024; do
    head -c $((kb * 1024)) /dev/urandom > $W/pat
    dd if=$W/pat of=$P bs=4096 seek=$OFF count=$((kb / 4)) oflag=direct conv=fsync,notrunc 2>/dev/null || { say "NVME-WT: write ${kb}K failed"; rc=1; break; }
    dd if=$P of=$W/rb bs=4096 skip=$OFF count=$((kb / 4)) iflag=direct 2>/dev/null
    if cmp -s $W/pat $W/rb; then say "NVME-WT: write ${kb}K OK, verified"; else say "NVME-WT: write ${kb}K readback differs"; rc=1; break; fi
    if [ "$(dmesg | tail -n +$((d0 + 1)) | grep -cE 'apif timeout|I/O error|sct 0x|reset_work')" != 0 ]; then
      dmesg | tail -n +$((d0 + 1)) | grep -E 'apif timeout|I/O error|sct 0x|reset_work' | tail -3 | cut -c1-150 | while read -r l; do say "NVME-WT: kernel: $l"; done
      rc=1; break
    fi
  done
  dd if=$W/orig of=$P bs=4096 seek=$OFF count=256 oflag=direct conv=fsync,notrunc 2>/dev/null
  dd if=$P of=$W/after bs=4096 skip=$OFF count=256 iflag=direct 2>/dev/null
  if cmp -s $W/orig $W/after; then say "NVME-WT: p5 window put back as found"; else say "NVME-WT: RESTORE MISMATCH on p5"; rc=1; fi
  if [ $rc = 0 ]; then say "NVME-WT: writes under SPTM verified, the root goes read-write"; else blockdev --setro $P; blockdev --setro /dev/nvme0n1; say "NVME-WT: FAILED, the root stays read-only with the overlay in RAM"; fi
  return $rc
}
rw=; grep -qw macho.rw /proc/cmdline && rw=1
if [ -n "$rw" ] && ! nvme_write_gate; then rw=; fi
if [ -n "$rw" ]; then
  # F35b: the root on NVMe read-write, as the daily system boots it. The write policy is the kernel guard (nvme-apple refuses every
  # write outside /chosen/m4,write-lba-range: p3 and the scratch slot p5); every other node stays setro as a second fence.
  # /etc and /usr/local are overlaid in RAM: every macho tweak below is volatile, the daily system never sees it; /home, /var, /usr persist.
  for d in /dev/nvme*n*; do case $d in /dev/nvme0n1|/dev/nvme0n1p3|/dev/nvme0n1p5) ;; *) blockdev --setro "$d" 2>/dev/null ;; esac; done
  say "NVME: rw disk $(blockdev --getro /dev/nvme0n1) p3 $(blockdev --getro /dev/nvme0n1p3), others ro p1 $(blockdev --getro /dev/nvme0n1p1) p2 $(blockdev --getro /dev/nvme0n1p2), max_hw_sectors_kb $(cat /sys/block/nvme0n1/queue/max_hw_sectors_kb)"
  mkdir -p /new
  if ! mount -t ext4 -o rw /dev/nvme0n1p3 /new || [ ! -x /new/usr/lib/systemd/systemd ]; then hold_forever "NVME: root not mountable read-write"; fi
  say "NVME-ROOT-OK read-write: $(grep -m1 PRETTY /new/etc/os-release); $(dmesg | grep -oE 'EXT4-fs \(nvme0n1p3\): (recovery complete|mounted filesystem [^ ]+ r[wo][^.]*)' | tail -1)"
  /tso-probe
  mount -t tmpfs -o mode=755 tmpfs /new/run || hold_forever "tmpfs on /run failed"
  for o in etc usr/local; do
    mkdir -p /new/run/macho-ov/$o/up /new/run/macho-ov/$o/work
    mount -t overlay overlay -o lowerdir=/new/$o,upperdir=/new/run/macho-ov/$o/up,workdir=/new/run/macho-ov/$o/work /new/$o || hold_forever "OVERLAY on /$o failed"
  done
  echo "# macho boot: root read-write on NVMe (p3); /etc and /usr/local overlaid in RAM" > /new/etc/fstab
  mkdir -p /new/var/lib/macho
else
# nothing below may write to the disk: every NVMe node read-only, root ro without journal replay, writes go to RAM
for d in /dev/nvme*n*; do blockdev --setro "$d" 2>/dev/null; done
say "NVME: ro disk $(blockdev --getro /dev/nvme0n1) p3 $(blockdev --getro /dev/nvme0n1p3), max_hw_sectors_kb $(cat /sys/block/nvme0n1/queue/max_hw_sectors_kb)"
mkdir -p /lower /upper /new
if ! mount -t ext4 -o ro,noload /dev/nvme0n1p3 /lower || [ ! -x /lower/usr/lib/systemd/systemd ]; then
    say "NVME: root not mountable, holding"
    while :; do sleep 30; say "HB up=$(cut -d' ' -f1 /proc/uptime) ticks=$(ticks)"; done
fi
say "NVME-ROOT-OK read-only, noload: $(grep -m1 PRETTY /lower/etc/os-release)"
/tso-probe
mount -t tmpfs -o mode=755 tmpfs /upper
mkdir -p /upper/up /upper/work
mount -t overlay overlay -o lowerdir=/lower,upperdir=/upper/up,workdir=/upper/work /new || { say "OVERLAY failed, holding"; while :; do sleep 30; done; }
echo "# macho boot: root read-only, overlay in RAM" > /new/etc/fstab
fi
[ "$draw" = 3 ] && touch /new/etc/macho-no-net
for u in fstrim.timer fstrim.service systemd-fsck-root.service systemd-hibernate-resume.service systemd-suspend.service systemd-hibernate.service; do
    ln -sf /dev/null /new/etc/systemd/system/$u
done
mkdir -p /new/usr/lib/modules/7.3.0-m4.macho /new/etc/systemd/user
cp /lib/modules/*.ko /lib/modules/modules.* /new/usr/lib/modules/7.3.0-m4.macho/ 2>/dev/null
# user units are masked system-wide in /etc/systemd/user (volatile), never in /home: a read-write root keeps /home as the daily system left it
# software session on simpledrm: Mesa falls back to llvmpipe by itself (KVM reproduction, same result without these); kept for the clients
# no asahi yet: Mesa falls back to software by itself (KVM); nothing may force it, the GPU session restart below inherits this file
# visible proof after switch_root: TSO prctl, CPU die temperature, fan speeds, system state
cp /tso-probe /new/usr/local/bin/macho-tso-probe
[ -f /macho-nvme-wt ] && cp /macho-nvme-wt /new/usr/local/bin/macho-nvme-wt && chmod 755 /new/usr/local/bin/macho-nvme-wt   # F35: the NVMe write test (sequencer step nvmew)
cp /usr/local/bin/macho-nvme-sizes /new/usr/local/bin/macho-nvme-sizes
cp /tso_litmus /new/usr/local/bin/macho-tso-litmus
cp /macho-kvm-test /new/usr/local/bin/macho-kvm-test
cp /tso-matrix /new/usr/local/bin/macho-tso-matrix
cat > /new/usr/local/bin/macho-status <<'S'
#!/bin/bash
L=/run/macho-status.log
touch $L; chmod 644 $L
fans() { for h in /sys/class/hwmon/hwmon*; do [ "$(cat $h/name)" = macsmc_hwmon ] && cat $h/fan*_input 2>/dev/null | tr '\n' ' '; done; }
line() { echo "$1" | tee -a $L > /dev/kmsg; }
/usr/local/bin/macho-tso-probe
# M3: secondaries one by one, each named on the log before the PSCI call, so the last line names the core if the machine
# stops. Order: an E core and a P core of the other cluster first (the litmus pair), then the rest. Logical numbers follow
# guest-native.dts: 0 = boot 0x10100; 1-4 E 0x0-0x3; 5-8 0x10101-4; 9-13 0x10200-4. Kernel cmdline macho.nosmp skips all of it.
temp_max() { cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null | sort -n | tail -1; }
litmus() {
  line "LITMUS: start pair cpu$1 cpu$2, $3 iterations per test (TSO off is the positive control)"
  /usr/local/bin/macho-tso-litmus "$1" "$2" "$3" > /run/macho-litmus-$1-$2.log 2>&1; rc=$?
  grep -E 'pinned|\[probe\]|MP forbidden|SB outcome|DEFAULT MP|TSO     MP|TSO     SB|XNU     MP|XNU     SB|>>>' /run/macho-litmus-$1-$2.log | cut -c1-110 | while read -r l; do line "LITMUS $1-$2: $l"; done
  line "LITMUS-RESULT pair $1-$2 rc=$rc (0 TSO ordered, 1 TSO NOT enforced, 2 no prctl, 3 inconclusive, 4 only the XNU state 0x12/~0xe00 orders)"
}
smp_up() {
  grep -qw macho.nosmp /proc/cmdline && { line "SMP: skipped, macho.nosmp"; return; }
  for c in 1 9 5 2 10 6 3 11 7 4 12 8 13; do
    [ "$(cat /sys/devices/system/cpu/cpu$c/online 2>/dev/null)" = 1 ] && continue    # the initrd started it
    t=$(temp_max)
    if [ -n "$t" ] && [ "$t" -gt 90000 ]; then line "SMP: stop before cpu$c, $t mC above 90000"; break; fi
    if [ -z "$t" ] && [ $c != 1 ] && [ $c != 9 ] && [ $c != 5 ]; then line "SMP: no temperature reading, stop at the litmus cores"; break; fi
    line "SMP: next cpu$c, $t mC, online $(cat /sys/devices/system/cpu/online)"
    sync
    [ -e /etc/macho-final ] && sleep 1 || sleep 3    # final: all thirteen came up one by one on F34, the pause only names the core on the log
    echo 1 > /sys/devices/system/cpu/cpu$c/online; rc=$?
    line "SMP: cpu$c rc=$rc online=$(cat /sys/devices/system/cpu/cpu$c/online) all $(cat /sys/devices/system/cpu/online)"
    dmesg | grep -E "CPU$c:|cpu$c|psci" | tail -3 | cut -c1-140 | while read -r l; do line "SMP-K: $l"; done
    [ "$rc" = 0 ] || { line "SMP: cpu$c failed, no further CPUs"; break; }
    [ -e /etc/macho-final ] && sleep 1 || sleep 5
  done
  line "SMP: finished, online $(cat /sys/devices/system/cpu/online), $(temp_max) mC"
