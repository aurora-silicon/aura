L=/run/macho-status.log; R=7.3.0-m4.macho; M=/usr/lib/modules/$R
say() { echo "PROVISION: $1" | tee -a $L > /dev/kmsg; }
WANT=26204c368f014664d5254ea8223ac72ca7abd641ff0476ae0b4dc4721beec9b2
if [ -f $M/.modpack-sha ] && [ "$(cat $M/.modpack-sha)" = "$WANT" ] && [ -d $M/kernel ]; then say "module pack already on the root ($(find $M/kernel -name '*.ko' | wc -l) .ko), depmod"; depmod $R; exit 0; fi
T=/run/modpack; mkdir -p $T
# F35.1: plain HTTP from the recovery server (F35 HW 11-02: the user's ssh to hypnos needs an agent, all six scp tries failed)
for i in 1 2 3 4 5 6; do
  curl -fsS --max-time 120 -o $T/pack.tar.zst http://192.168.1.25:8616/modpack-$R.tar.zst 2>>$L && break
  say "fetch from 192.168.1.25:8616 failed, try $i: $(tail -n 1 $L | cut -c1-80)"; sleep 10
done
[ -s $T/pack.tar.zst ] || { say "no module pack, the boot set stays"; exit 1; }
got=$(sha256sum < $T/pack.tar.zst | cut -c1-64)
[ "$got" = "$WANT" ] || { say "module pack sha mismatch ($got), refused"; rm -f $T/pack.tar.zst; exit 1; }
# never extract onto /: the archive's "lib/" would replace the /lib -> usr/lib symlink with a directory and take the loader away
# (F35 HW 11-02 10:38, repaired by hand over the ACM busybox). Unpack aside, then copy only this release's tree into place.
rm -rf $T/x && mkdir -p $T/x && tar --zstd -xf $T/pack.tar.zst -C $T/x && [ -d $T/x/lib/modules/$R ] || { say "module pack has no lib/modules/$R, refused"; exit 1; }
mkdir -p $M && cp -a $T/x/lib/modules/$R/. $M/ && rm -rf $T/x
# the pack's nvme-apple.ko is the stock build; the write-capable one of this image stays alone under $M (copied from the initrd at boot)
rm -f $M/kernel/drivers/nvme/host/nvme-apple.ko
echo "$WANT" > $M/.modpack-sha && depmod $R && sync
say "module pack installed: $(find $M/kernel -name '*.ko' | wc -l) .ko under $M, root $(grep -oE '^/dev/nvme0n1p3 / ext4 r[wo]' /proc/mounts | awk '{print $4}')"
rm -f $T/pack.tar.zst
S
