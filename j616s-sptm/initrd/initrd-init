# what stuck: every thread in D, user threads in R. No cmdline, it takes mmap_lock
task_dump() {
  for q in /proc/[0-9]*/task/[0-9]*; do
    s=$(cat $q/stat 2>/dev/null); [ -n "$s" ] || continue
    c=${s#*\(}; c=${c%\)*}
    set -- ${s##*) }
    case "$1" in
      D) ;;
      R) [ $(( $7 & 0x200000 )) = 0 ] || continue ;;
      *) continue ;;
    esac
    line "TASK: ${q##*/} ($c) state $1 cpu ${37} wchan $(cat $q/wchan 2>/dev/null) $(head -n3 $q/stack 2>/dev/null | tr '\n' ' ')"
  done
}
# aside and bounded: a task in D holds a plain timeout for ever, and it must not hide the later steps and the remote loop
# F35: a ledger on the root (persistent when the root is read-write): a step that began and never ended on an earlier boot is
# skipped on this one, so a stop in a new device cannot repeat on every power cycle (rm /var/lib/macho/steps/<step>.failed to retry)
LEDGER=/var/lib/macho/steps
ledger_open() { mkdir -p $LEDGER 2>/dev/null; for f in $LEDGER/*.attempt; do [ -e "$f" ] || continue; mv "$f" "${f%.attempt}.failed"; line "SEQ: ${f##*/} did not finish on an earlier boot, skipped now"; done; }
run_step() {
  local st=$1 p i=0 lim
