<!--
  AuractlDevice.kext Info.plist.

  Loaded on the SIP-disabled J616s macOS with `kmutil load -p AuractlDevice.kext` (or the legacy
  `kextload AuractlDevice.kext`). Dev-signed; SIP must be off because the driver maps a fixed
  guest-physical page directly (MVP), which the platform otherwise refuses.

  IOKitPersonalities: with no ADT node in the MVP, we match the platform's root (IOResources) so the
  driver instantiates unconditionally and maps the fixed AURACTL_MMIO_BASE page itself. The
  discoverable alternative (match "aura,auractl" from the ADT) would set IOProviderClass/
  IONameMatch to the ADT node instead; left out of the MVP on purpose.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>English</string>
    <key>CFBundleExecutable</key>
    <string>AuractlDevice</string>
    <key>CFBundleIdentifier</key>
    <string>org.aurorasilicon.AuractlDevice</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>AuractlDevice</string>
    <key>CFBundlePackageType</key>
    <string>KEXT</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>OSBundleRequired</key>
    <string>Local-Root</string>
    <key>IOKitPersonalities</key>
    <dict>
        <key>AuractlDevice</key>
        <dict>
            <key>CFBundleIdentifier</key>
            <string>org.aurorasilicon.AuractlDevice</string>
            <!-- IOService class that drives the control page. -->
            <key>IOClass</key>
            <string>AuractlDevice</string>
            <!-- MVP: match IOResources so we instantiate without an ADT node. -->
            <key>IOProviderClass</key>
            <string>IOResources</string>
            <key>IOMatchCategory</key>
            <string>AuractlDevice</string>
            <key>IOResourceMatch</key>
            <string>IOKit</string>
            <!-- Name the user client class IOKit instantiates on IOServiceOpen(). -->
            <key>IOUserClientClass</key>
            <string>AuractlUserClient</string>
        </dict>
    </dict>
    <key>OSBundleLibraries</key>
    <dict>
        <key>com.apple.kpi.iokit</key>
        <string>12.0.0</string>
        <key>com.apple.kpi.libkern</key>
        <string>12.0.0</string>
        <key>com.apple.kpi.mach</key>
        <string>12.0.0</string>
    </dict>
</dict>
</plist>
